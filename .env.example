NODE_ENV=development
PORT=3000
APP_NAME=CelebraCraft
BASE_URL=http://localhost:3000

MONGO_URI=mongodb://127.0.0.1:27017/celebracraft

# How many reverse-proxy hops Express should trust when reading the real
# client IP from X-Forwarded-For (see app.js). This directly controls
# whether IP-based rate limits and the Surprise Cards report/auto-hide
# feature (controllers/surpriseCardsController.js) can be spoofed or
# accidentally shared across unrelated visitors — get it wrong in either
# direction and one of those breaks. Count your ACTUAL deployment:
#   0  = no reverse proxy at all; this process receives raw internet
#        connections directly (e.g. a bare EC2 instance with no Nginx/LB).
#   1  = exactly one reverse proxy or load balancer sits directly in front
#        of this process (a single Nginx box, or most "just deploy it"
#        platforms like Render/Railway/Heroku-style dynos).
#   2+ = a CDN or extra load balancer sits in front of that proxy too
#        (e.g. Cloudflare -> Nginx -> this app = 2).
# Defaults to 1 if unset, matching this app's previous hardcoded value —
# do not assume that's correct for your setup; verify it.
TRUST_PROXY_HOPS=1

SESSION_SECRET=change_this_to_a_long_random_string
# 32-byte value (hex or plain string, either is hashed down) used to encrypt
# Razorpay/SMTP secrets at rest in the Setting document. Falls back to
# SESSION_SECRET if unset — set a dedicated value in production.
ENCRYPTION_KEY=change_this_to_a_different_long_random_string

RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

ADMIN_NAME=Admin
ADMIN_EMAIL=admin@celebracraft.com
ADMIN_PASSWORD=ChangeMe123!

# "Continue with Google" login/signup (see config/passport.js). Leave both
# blank to hide the Google button's effect entirely — startGoogleAuth falls
# back to a flash message instead of crashing on an unregistered strategy.
# Callback URL registered with Google must be exactly {BASE_URL}/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP is also configurable from the admin Settings > Email tab, which
# takes priority over these when set. These are only the fallback.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM_EMAIL=no-reply@celebracraft.com

# Optional — leave all three blank to store uploads on local disk (public/images/uploads)
# instead, which is fine for local dev but won't survive most hosting platforms' ephemeral
# filesystems in production. Set all three to switch to Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
