<%- include('../layouts/dashboard-head', { title }) %>

<a href="/admin/surprise-cards" class="text-sm text-amber-700 font-semibold mb-4 inline-block">&larr; Back to surprise cards</a>

<div class="grid lg:grid-cols-3 gap-6 mb-6">
  <div class="card-panel lg:col-span-2">
    <div class="flex items-start justify-between gap-3 mb-3">
      <div>
        <h2 class="text-xl font-semibold"><%= card.recipientName %></h2>
        <p class="text-sm text-stone-400">/c/<%= card.slug %></p>
      </div>
      <div class="flex gap-1 shrink-0">
        <span class="text-xs font-semibold px-2 py-1 rounded-full bg-rose-50 text-rose-600"><%= card.type[0].toUpperCase() + card.type.slice(1) %></span>
        <% if (card.isDisabled) { %>
          <span class="text-xs font-semibold px-2 py-1 rounded-full bg-stone-200 text-stone-600">Disabled</span>
        <% } %>
        <% if (card.isReported) { %>
          <span class="text-xs font-semibold px-2 py-1 rounded-full bg-red-50 text-red-600">Reported<% if (card.reportCount > 1) { %> (<%= card.reportCount %>)<% } %></span>
        <% } %>
      </div>
    </div>

    <dl class="grid sm:grid-cols-2 gap-3 text-sm">
      <div><dt class="text-stone-400">Sender</dt><dd class="font-semibold"><%= card.senderName %></dd></div>
      <div><dt class="text-stone-400">Created</dt><dd class="font-semibold"><%= card.createdAt.toLocaleString() %></dd></div>
      <div><dt class="text-stone-400">Opened</dt><dd class="font-semibold"><%= card.openedAt ? card.openedAt.toLocaleString() : 'Not opened yet' %></dd></div>
      <div><dt class="text-stone-400">Photos</dt><dd class="font-semibold"><%= card.photos?.length || 0 %></dd></div>
      <% if (card.isReported) { %>
        <div><dt class="text-stone-400">Reported</dt><dd class="font-semibold"><%= card.reportedAt ? card.reportedAt.toLocaleString() : '—' %> (<%= card.reportCount %>x)</dd></div>
      <% } %>
    </dl>
  </div>

  <div class="card-panel">
    <h3 class="font-semibold mb-3">Admin actions</h3>
    <div class="space-y-3">
      <form action="/admin/surprise-cards/<%= card._id %>/toggle-disable" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button type="submit" class="btn-secondary w-full"><%= card.isDisabled ? 'Enable card' : 'Disable card' %></button>
      </form>
      <% if (!card.isDisabled) { %>
        <a href="/c/<%= card.slug %>" target="_blank" class="btn-secondary w-full text-center block">View live link</a>
      <% } %>
      <form action="/admin/surprise-cards/<%= card._id %>/delete" method="POST" onsubmit="return confirm('Delete this card permanently?');"><input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button type="submit" class="btn-danger w-full">Delete card</button>
      </form>
    </div>
  </div>
</div>

<div class="card-panel mb-6">
  <h3 class="font-semibold mb-4">Results</h3>

  <% if (card.type === 'apology') { %>
    <dl class="grid sm:grid-cols-2 gap-3 text-sm">
      <div><dt class="text-stone-400">Answer</dt><dd class="font-semibold">
        <% if (card.recipientAnswer === 'yes') { %>Forgiven 💛
        <% } else if (card.recipientAnswer === 'not_yet') { %>Said "not yet"
        <% } else { %>No answer yet
        <% } %>
      </dd></div>
      <% if (card.answeredAt) { %><div><dt class="text-stone-400">Answered at</dt><dd class="font-semibold"><%= card.answeredAt.toLocaleString() %></dd></div><% } %>
    </dl>

  <% } else if (card.type === 'anniversary') { %>
    <p class="text-sm text-stone-500">This card type doesn't save the recipient's Yes/No tap — it's a navigational step only, nothing is recorded server-side for it yet.</p>
    <dl class="grid sm:grid-cols-2 gap-3 text-sm mt-3">
      <div><dt class="text-stone-400">Together since</dt><dd class="font-semibold"><%= card.fields?.togetherDate ? new Date(card.fields.togetherDate).toLocaleDateString() : '—' %></dd></div>
      <div><dt class="text-stone-400">Anniversary number</dt><dd class="font-semibold"><%= card.fields?.anniversaryNumber || '—' %></dd></div>
      <div><dt class="text-stone-400">Timeline moments</dt><dd class="font-semibold"><%= card.fields?.timeline?.length || 0 %></dd></div>
      <div><dt class="text-stone-400">"Love" lines</dt><dd class="font-semibold"><%= card.fields?.loveLines?.length || 0 %></dd></div>
    </dl>

  <% } else if (card.type === 'puzzle') { %>
    <dl class="grid sm:grid-cols-2 gap-3 text-sm">
      <div><dt class="text-stone-400">Difficulty</dt><dd class="font-semibold"><%= card.fields?.difficulty %> (<%= card.fields?.gridSize %>&times;<%= card.fields?.gridSize %>)</dd></div>
      <div><dt class="text-stone-400">Status</dt><dd class="font-semibold"><%= card.recipientAnswer === 'solved' ? 'Solved 🎉' : (card.fields?.liveProgress ? 'Playing now' : (card.openedAt ? 'Opened, not started' : 'Not opened')) %></dd></div>
      <% if (card.recipientAnswer === 'solved' && card.fields?.solveStats) { %>
        <div><dt class="text-stone-400">Moves</dt><dd class="font-semibold"><%= card.fields.solveStats.moves %></dd></div>
        <div><dt class="text-stone-400">Time</dt><dd class="font-semibold"><%= card.fields.solveStats.timeSeconds %>s</dd></div>
        <div><dt class="text-stone-400">Peeks used</dt><dd class="font-semibold"><%= card.fields.solveStats.peeks %></dd></div>
      <% } else if (card.fields?.liveProgress) { %>
        <div><dt class="text-stone-400">Current moves</dt><dd class="font-semibold"><%= card.fields.liveProgress.moves %></dd></div>
        <div><dt class="text-stone-400">Current time</dt><dd class="font-semibold"><%= card.fields.liveProgress.timeSeconds %>s</dd></div>
        <div><dt class="text-stone-400">Last update</dt><dd class="font-semibold"><%= new Date(card.fields.liveProgress.updatedAt).toLocaleString() %></dd></div>
      <% } %>
    </dl>

    <% if (card.fields?.answers && Object.keys(card.fields.answers).length) { %>
      <div class="mt-4 pt-4 border-t border-amber-100">
        <p class="text-stone-400 text-sm mb-2">Post-solve question answers</p>
        <ul class="text-sm space-y-2">
          <% Object.keys(card.fields.answers).sort((a, b) => a - b).forEach((i) => { const a = card.fields.answers[i]; %>
            <li><span class="text-stone-400"><%= a.text %>:</span> <span class="font-semibold"><%= a.answer %></span></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

  <% } else if (card.type === 'friendship') { %>
    <dl class="grid sm:grid-cols-2 gap-3 text-sm">
      <div><dt class="text-stone-400">Quiz questions</dt><dd class="font-semibold"><%= card.fields?.quiz?.length || 0 %></dd></div>
      <% if (card.fields?.quizResult) { %>
        <div><dt class="text-stone-400">Quiz score</dt><dd class="font-semibold"><%= card.fields.quizResult.score %> / <%= card.fields.quizResult.total %></dd></div>
        <div><dt class="text-stone-400">Completed</dt><dd class="font-semibold"><%= new Date(card.fields.quizResult.completedAt).toLocaleString() %></dd></div>
      <% } else { %>
        <div><dt class="text-stone-400">Quiz score</dt><dd class="font-semibold">Not taken yet</dd></div>
      <% } %>
    </dl>
  <% } %>
</div>

<%- include('../layouts/dashboard-foot') %>
