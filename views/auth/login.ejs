<%- include('../layouts/main-head', { title }) %>

<div class="max-w-md mx-auto card-panel">
  <h2 class="text-2xl font-semibold mb-1">Welcome back</h2>
  <p class="text-stone-500 mb-6">Log in to manage your cards.</p>

  <form action="/login" method="POST" class="space-y-4"><input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <% if (typeof redirectTo !== 'undefined' && redirectTo) { %><input type="hidden" name="redirectTo" value="<%= redirectTo %>" /><% } %>
    <div>
      <label class="label" for="email">Email</label>
      <input class="input-field" type="email" id="email" name="email" value="<%= oldInput.email || '' %>" required />
    </div>
    <div>
      <label class="label" for="password">Password</label>
      <input class="input-field" type="password" id="password" name="password" required />
    </div>
    <div class="text-right">
      <a href="/forgot-password" class="text-sm text-amber-700 font-semibold">Forgot password?</a>
    </div>
    <button type="submit" class="btn-primary w-full">Log in</button>
  </form>

  <div class="flex items-center gap-3 my-5">
    <div class="flex-1 border-t border-amber-100"></div>
    <span class="text-xs text-stone-400">or</span>
    <div class="flex-1 border-t border-amber-100"></div>
  </div>
  <a
    href="/auth/google<%= typeof redirectTo !== 'undefined' && redirectTo ? `?redirect=${encodeURIComponent(redirectTo)}` : '' %>"
    class="btn-secondary w-full flex items-center justify-center gap-2"
  >
    <svg width="18" height="18" viewBox="0 0 48 48"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.9 32.6 29.4 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.1 8 2.9l6-6C34.5 5.1 29.5 3 24 3 12.4 3 3 12.4 3 24s9.4 21 21 21 21-9.4 21-21c0-1.4-.1-2.7-.4-3.5z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.5 15.9 18.9 13 24 13c3.1 0 5.8 1.1 8 2.9l6-6C34.5 5.1 29.5 3 24 3c-7.5 0-14 4.2-17.7 10.4z"/><path fill="#4CAF50" d="M24 45c5.4 0 10.3-2.1 14-5.5l-6.5-5.4C29.4 35.9 26.8 37 24 37c-5.4 0-9.9-3.4-11.3-8.1l-6.6 5.1C9.9 40.7 16.4 45 24 45z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.7 2.1-2 3.9-3.7 5.1l6.5 5.4C41.9 35.9 45 30.5 45 24c0-1.4-.1-2.7-.4-3.5z"/></svg>
    Continue with Google
  </a>

  <p class="text-sm text-stone-500 mt-6 text-center">
    New here?
    <a href="/register<%= typeof redirectTo !== 'undefined' && redirectTo ? `?redirect=${encodeURIComponent(redirectTo)}` : '' %>" class="text-amber-700 font-semibold">Create an account</a>
  </p>
</div>

<%- include('../layouts/main-foot') %>
