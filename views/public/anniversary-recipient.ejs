<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <meta name="description" content="A little surprise for <%= card.recipientName %>." />
  <!-- Deliberately generic Open Graph text — WhatsApp/Instagram shouldn't spoil the card before it's opened. -->
  <meta property="og:title" content="<%= title %>" />
  <meta property="og:description" content="Tap to open." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,700;1,500&family=DM+Sans:wght@400;500;600&family=Caveat:wght@500&display=swap"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/css/cards.css" />
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>
  <style>
    html, body { height: 100%; margin: 0; overflow: hidden; }
    .theme-anniversary {
      --gold: #C9A86A;
      --rose: #D8A7A7;
      --cocoa: #3E2F2B;
      background: #FBF6EE;
      height: 100%;
    }
    .an-italic { font-family: var(--font-heading); font-style: italic; }

    /* ===== Framed-invitation border ===== */
    .ann-frame {
      position: fixed; inset: 12px;
      border: 1px solid var(--gold);
      pointer-events: none;
      z-index: 5;
    }

    /* ===== Screen 1: Our Day ===== */
    .ann-eyebrow {
      font-family: var(--font-body); font-size: 12px; font-weight: 600;
      letter-spacing: 0.18em; text-transform: uppercase; color: var(--gold);
    }
    .ann-illustration-wrap { position: relative; width: 160px; height: 110px; }
    .ann-illustration-wrap svg { width: 100%; height: 100%; }
    .ann-hearts-layer { position: absolute; inset: -20px; overflow: visible; pointer-events: none; }

    .ann-countdown { display: flex; gap: 0.75rem; }
    .ann-countdown-box {
      background: var(--white-soft); border: 1px solid rgba(201,168,106,0.35);
      border-radius: 12px; padding: 0.75rem 0.9rem; min-width: 64px; text-align: center;
      box-shadow: var(--shadow-soft);
    }
    .ann-countdown-num {
      font-family: var(--font-heading); font-size: 1.9rem; font-weight: 600; color: var(--cocoa);
      transition: opacity 250ms var(--ease-soft), transform 250ms var(--ease-soft);
    }
    .ann-countdown-num.ann-flip { opacity: 0; transform: translateY(-6px); }
    .ann-countdown-label {
      font-family: var(--font-body); font-size: 10px; font-weight: 600;
      letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.55; margin-top: 0.2rem;
    }
    .ann-countdown-date { font-size: 14px; opacity: 0.7; margin-top: 0.75rem; }
    .ann-today-message { font-size: 1.5rem; font-weight: 600; color: var(--gold); }

    .ann-question-wrap { display: flex; flex-direction: column; align-items: center; gap: 1rem; }
    .ann-buttons { display: flex; gap: 1rem; }

    @media (prefers-reduced-motion: reduce) {
      .ann-countdown-num { transition: none; }
    }

    /* ===== Screen 2: Our Story ===== */
    #screen-our-story { overflow-y: auto; justify-content: flex-start; padding-top: 3rem; padding-bottom: 7rem; }
    .ann-story-track {
      position: relative;
      width: 100%; max-width: 460px; margin: 0 auto;
      padding-left: 36px;
    }
    .ann-story-track::before {
      content: ''; position: absolute; top: 4px; bottom: 4px; left: 11px;
      width: 1px; background: var(--gold);
    }
    @media (min-width: 640px) {
      .ann-story-track { padding-left: 0; }
      .ann-story-track::before { left: 50%; }
    }
    .ann-moment {
      position: relative;
      margin-bottom: 2rem;
      opacity: 0; transform: translateY(24px);
      transition: opacity 700ms var(--ease-soft), transform 700ms var(--ease-soft);
    }
    .ann-moment.ann-moment-visible { opacity: 1; transform: translateY(0); }
    .ann-moment-heart {
      position: absolute; left: -36px; top: 2px; width: 22px; height: 22px;
      display: flex; align-items: center; justify-content: center;
      background: var(--cream); border-radius: 50%;
    }
    @media (min-width: 640px) { .ann-moment-heart { left: 50%; transform: translateX(-50%); } }
    .ann-moment-card {
      background: var(--white-soft); border-radius: 14px; box-shadow: var(--shadow-soft);
      padding: 1.1rem 1.25rem; text-align: left;
    }
    .ann-moment-date { font-family: var(--font-heading); font-style: italic; color: var(--gold); font-size: 1rem; margin-bottom: 0.3rem; }
    .ann-moment-caption { font-size: 15px; line-height: 1.5; }
    .ann-moment-photo { width: 100%; max-width: 220px; border-radius: 12px; box-shadow: var(--shadow-soft); margin-top: 0.75rem; display: block; }
    .ann-story-end { text-align: center; font-family: var(--font-hand); font-size: 1.4rem; color: var(--gold); margin: 1rem 0 2rem; }

    @media (prefers-reduced-motion: reduce) {
      .ann-moment { transition: none; }
    }

    /* ===== Screen 3: Things I Love About You ===== */
    #screen-love { overflow-y: auto; justify-content: flex-start; padding-top: 3rem; padding-bottom: 7rem; }
    .ann-love-stack { width: 100%; max-width: 340px; margin: 0 auto; display: flex; flex-direction: column; gap: 1.1rem; }
    .ann-flip-card {
      perspective: 1000px; height: 110px; cursor: pointer;
      opacity: 0; transform: translateY(16px);
      transition: opacity 500ms var(--ease-soft), transform 500ms var(--ease-soft);
    }
    .ann-flip-card.ann-love-visible { opacity: 1; transform: translateY(0); }
    .ann-flip-inner {
      position: relative; width: 100%; height: 100%;
      transform-style: preserve-3d;
      transition: transform 600ms var(--ease-soft);
    }
    .ann-flip-card.ann-flipped .ann-flip-inner { transform: rotateY(180deg); }
    .ann-flip-face {
      position: absolute; inset: 0; backface-visibility: hidden;
      border-radius: 14px; box-shadow: var(--shadow-soft);
      display: flex; align-items: center; justify-content: center; text-align: center; padding: 1rem;
    }
    .ann-flip-front { background: var(--rose); font-size: 2rem; }
    .ann-flip-back { background: var(--white-soft); transform: rotateY(180deg); font-family: var(--font-hand); font-size: 1.3rem; color: var(--cocoa); }

    @media (prefers-reduced-motion: reduce) {
      .ann-flip-card, .ann-flip-inner { transition: none; }
    }

    /* ===== Screen 4: The Letter ===== */
    .theme-anniversary .sc-envelope-back { background: var(--cream, #FBF6EE); border: 1px solid var(--gold); }
    .theme-anniversary .sc-envelope-flap { background: #F3E7CF; border-bottom: 1px solid var(--gold); }
    .ann-wax-seal {
      position: absolute; left: 50%; top: 92px; transform: translate(-50%, -50%);
      width: 36px; height: 36px; border-radius: 50%;
      background: radial-gradient(circle at 35% 30%, #DEBF8C, var(--gold));
      box-shadow: var(--shadow-soft);
      display: flex; align-items: center; justify-content: center;
      font-size: 14px; color: var(--white-soft); z-index: 2;
    }
    .ann-letter-signed { font-family: var(--font-hand); font-size: 1.3rem; opacity: 0; margin-top: 1rem; transition: opacity 500ms var(--ease-soft); }
    .ann-letter-signed.ann-visible { opacity: 1; }

    /* ===== Screen 5: Together Since ===== */
    .ann-together-headline { max-width: 480px; }
    .ann-days-counter {
      font-family: var(--font-heading); font-size: 1.6rem; color: var(--gold); margin-top: 0.5rem;
    }
    .ann-days-label { font-size: 13px; opacity: 0.6; margin-top: 0.2rem; }
  </style>
</head>
<body class="sc-root theme-anniversary">
  <div class="ann-frame"></div>

  <div class="sc-screen-container">
    <!-- ===== Screen 1: Our Day ===== -->
    <section class="sc-screen sc-active" id="screen-our-day">
      <p class="ann-eyebrow"><%= anniversaryLabel %></p>
      <h1 class="sc-heading an-italic" style="margin-bottom: 0.25rem;">Happy Anniversary, my love</h1>

      <div class="ann-illustration-wrap">
        <div class="ann-hearts-layer" id="annHeartsLayer"></div>
        <%- include('../partials/couple-illustration-svg', { style: card.fields.illustrationStyle }) %>
      </div>

      <div id="countdownArea">
        <div class="ann-countdown" id="countdownBoxes">
          <div class="ann-countdown-box"><p class="ann-countdown-num" id="cdDays">00</p><p class="ann-countdown-label">Days</p></div>
          <div class="ann-countdown-box"><p class="ann-countdown-num" id="cdHours">00</p><p class="ann-countdown-label">Hrs</p></div>
          <div class="ann-countdown-box"><p class="ann-countdown-num" id="cdMinutes">00</p><p class="ann-countdown-label">Min</p></div>
          <div class="ann-countdown-box"><p class="ann-countdown-num" id="cdSeconds">00</p><p class="ann-countdown-label">Sec</p></div>
        </div>
        <p class="ann-countdown-date" id="countdownDate"></p>
      </div>

      <div class="ann-question-wrap">
        <h2 id="questionText" style="margin: 0;">Ready for a little surprise?</h2>
        <div class="ann-buttons">
          <button type="button" class="sc-btn" id="annYesBtn">Yes</button>
          <button type="button" class="sc-btn sc-btn-outline" id="annNoBtn">No</button>
        </div>
      </div>
    </section>

    <!-- ===== Screen 2: Our Story (skipped entirely if no moments) ===== -->
    <section class="sc-screen" id="screen-our-story">
      <h1 class="sc-heading an-italic" style="margin-bottom: 2rem;">Our story so far</h1>
      <div class="ann-story-track" id="storyTrack">
        <% (card.fields.timeline || []).forEach((moment) => { %>
          <div class="ann-moment">
            <div class="ann-moment-heart">💛</div>
            <div class="ann-moment-card">
              <% if (moment.dateOrLabel) { %><p class="ann-moment-date an-italic"><%= moment.dateOrLabel %></p><% } %>
              <% if (moment.caption) { %><p class="ann-moment-caption"><%= moment.caption %></p><% } %>
              <% if (moment.photo) { %><img class="ann-moment-photo" src="<%= moment.photo %>" alt="A shared memory" /><% } %>
            </div>
          </div>
        <% }) %>
      </div>
      <p class="ann-story-end">...and many more to come 💛</p>
      <button type="button" class="sc-btn" id="storyContinueBtn">Continue →</button>
    </section>

    <!-- ===== Screen 3: Things I Love About You (skipped entirely if empty) ===== -->
    <section class="sc-screen" id="screen-love">
      <h1 class="sc-heading an-italic" style="margin-bottom: 2rem;">Things I love about you</h1>
      <div class="ann-love-stack" id="loveStack">
        <% (card.fields.loveLines || []).forEach((line, i) => { %>
          <div class="ann-flip-card" data-love-card data-index="<%= i %>">
            <div class="ann-flip-inner">
              <div class="ann-flip-face ann-flip-front">💛</div>
              <div class="ann-flip-face ann-flip-back"><%= line %></div>
            </div>
          </div>
        <% }) %>
      </div>
      <button type="button" class="sc-btn" id="loveNextBtn" style="margin-top: 1.5rem; display: none;">Next →</button>
    </section>

    <!-- ===== Screen 4: The Letter ===== -->
    <section class="sc-screen" id="screen-letter">
      <div class="sc-hearts-layer" id="letterHeartsLayer"></div>

      <div class="sc-envelope-wrap" id="annEnvelope" style="position: relative; z-index: 1;">
        <div class="sc-envelope-back"></div>
        <div class="sc-envelope-flap"></div>
        <div class="ann-wax-seal">💛</div>
      </div>
      <div class="sc-letter" id="annLetter" style="position: relative; z-index: 1;">
        <p class="sc-letter-text" id="annLetterText"></p>
        <p class="ann-letter-signed" id="annLetterSigned">Yours, always, <%= card.senderName %></p>
      </div>
    </section>

    <!-- ===== Screen 5: Together Since ===== -->
    <section class="sc-screen" id="screen-together">
      <h1 class="sc-heading an-italic ann-together-headline" id="togetherHeadline"></h1>
      <p class="ann-days-counter" id="daysCounter"></p>
      <p class="ann-days-label">total days together, and counting</p>
      <div class="ann-buttons" style="margin-top: 1.5rem;">
        <button type="button" class="sc-btn sc-btn-outline" id="reliveBtn">Relive it again 🔁</button>
        <a href="/cards/anniversary/create" class="sc-btn sc-btn-gold">Create your own ✨</a>
      </div>
    </section>
  </div>

  <script src="/js/cardComponents.js"></script>
  <script>
    const S = window.SurpriseCard;

    S.startFloatingHearts(document.getElementById('annHeartsLayer'), { color: '#D8A7A7', count: 6, intervalMs: 1400 });

    // --- Countdown to the next anniversary, entirely in local time ---
    // togetherMonth/togetherDay are plain numbers (month already 0-indexed,
    // matching JS Date) — reconstructing the date with new Date(y, m, d)
    // never touches UTC, so there's no off-by-one-day risk for a recipient
    // west of UTC (see the comment in surpriseCardsController.viewSurpriseCard).
    const TOGETHER_MONTH = <%= togetherMonth %>;
    const TOGETHER_DAY = <%= togetherDay %>;

    function nextAnniversaryDate(now) {
      let next = new Date(now.getFullYear(), TOGETHER_MONTH, TOGETHER_DAY, 0, 0, 0, 0);
      if (next < now && !isToday(now)) next = new Date(now.getFullYear() + 1, TOGETHER_MONTH, TOGETHER_DAY);
      return next;
    }
    function isToday(now) {
      return now.getMonth() === TOGETHER_MONTH && now.getDate() === TOGETHER_DAY;
    }

    const countdownDateEl = document.getElementById('countdownDate');
    const countdownAreaEl = document.getElementById('countdownArea');
    const nextDateForLabel = nextAnniversaryDate(new Date());
    countdownDateEl.textContent = nextDateForLabel.toLocaleDateString(undefined, { month: 'long', day: 'numeric' });

    let confettiFired = false;
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function setNumber(el, value) {
      const text = String(value).padStart(2, '0');
      if (el.textContent === text) return;
      if (!prefersReducedMotion) {
        el.classList.add('ann-flip');
        requestAnimationFrame(() => {
          el.textContent = text;
          requestAnimationFrame(() => el.classList.remove('ann-flip'));
        });
      } else {
        el.textContent = text;
      }
    }

    function tickCountdown() {
      const now = new Date();

      if (isToday(now)) {
        if (countdownAreaEl.querySelector('.ann-today-message') === null) {
          countdownAreaEl.innerHTML = '<p class="ann-today-message">Today is our day! 🎉</p>';
          if (!confettiFired) {
            confettiFired = true;
            S.burstConfetti({ colors: ['#C9A86A', '#D8A7A7', '#FBF6EE'], particleCount: 80, spread: 100 });
          }
        }
        return;
      }

      const target = nextAnniversaryDate(now);
      const diffMs = Math.max(target.getTime() - now.getTime(), 0);
      const days = Math.floor(diffMs / 86400000);
      const hours = Math.floor((diffMs % 86400000) / 3600000);
      const minutes = Math.floor((diffMs % 3600000) / 60000);
      const seconds = Math.floor((diffMs % 60000) / 1000);

      setNumber(document.getElementById('cdDays'), days);
      setNumber(document.getElementById('cdHours'), hours);
      setNumber(document.getElementById('cdMinutes'), minutes);
      setNumber(document.getElementById('cdSeconds'), seconds);
    }
    tickCountdown();
    setInterval(tickCountdown, 1000);

    // --- Question ---
    const questionText = document.getElementById('questionText');
    let askedOnce = false;

    document.getElementById('annNoBtn').addEventListener('click', () => {
      if (!askedOnce) {
        askedOnce = true;
        questionText.textContent = 'Are you sure? 🥺';
      }
    });

    // --- Screen navigation, skipping Screen 2/3 entirely when this card
    // has no timeline moments / no love lines (not just hiding empty
    // content — the screen never shows at all, per spec). ---
    const HAS_TIMELINE = <%= (card.fields.timeline || []).length > 0 %>;
    const HAS_LOVE_LINES = <%= (card.fields.loveLines || []).length > 0 %>;
    const screenOrder = ['screen-our-day'];
    if (HAS_TIMELINE) screenOrder.push('screen-our-story');
    if (HAS_LOVE_LINES) screenOrder.push('screen-love');
    screenOrder.push('screen-letter', 'screen-together');

    let currentScreenIndex = 0;
    function showScreenByOrderIndex(i) {
      currentScreenIndex = Math.min(Math.max(i, 0), screenOrder.length - 1);
      document.querySelectorAll('.sc-screen').forEach((el) => el.classList.remove('sc-active'));
      const activeId = screenOrder[currentScreenIndex];
      document.getElementById(activeId).classList.add('sc-active');
      if (activeId === 'screen-letter') startLetterScreen();
      if (activeId === 'screen-together') startTogetherScreen();
    }
    function goToNextScreen() {
      showScreenByOrderIndex(currentScreenIndex + 1);
    }

    document.getElementById('annYesBtn').addEventListener('click', goToNextScreen);
    document.getElementById('storyContinueBtn')?.addEventListener('click', goToNextScreen);

    // --- Screen 2: moments fade + slide in as they scroll into view ---
    if (HAS_TIMELINE) {
      const moments = document.querySelectorAll('#storyTrack .ann-moment');
      if (!prefersReducedMotion && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('ann-moment-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.25 }
        );
        moments.forEach((el) => io.observe(el));
      } else {
        moments.forEach((el) => el.classList.add('ann-moment-visible'));
      }
    }

    // --- Screen 3: cards appear one at a time; tapping one flips it and
    // reveals the next; once every card is flipped, show "Next →". ---
    if (HAS_LOVE_LINES) {
      const loveCards = Array.from(document.querySelectorAll('[data-love-card]'));
      const loveNextBtn = document.getElementById('loveNextBtn');
      let flippedCount = 0;

      function revealLoveCard(index) {
        if (index >= loveCards.length) return;
        loveCards[index].classList.add('ann-love-visible');
      }

      loveCards.forEach((card, index) => {
        card.addEventListener('click', () => {
          if (card.classList.contains('ann-flipped')) return;
          card.classList.add('ann-flipped');
          flippedCount += 1;
          revealLoveCard(index + 1);
          if (flippedCount >= loveCards.length) loveNextBtn.style.display = '';
        });
      });

      revealLoveCard(0);
      loveNextBtn.addEventListener('click', goToNextScreen);
    }

    // --- Screen 4: The Letter ---
    let letterStarted = false;
    function startLetterScreen() {
      if (letterStarted) return;
      letterStarted = true;

      S.startFloatingHearts(document.getElementById('letterHeartsLayer'), { color: '#D8A7A7', count: 10 });

      S.createEnvelopeLetter({
        wrapEl: document.getElementById('annEnvelope'),
        letterEl: document.getElementById('annLetter'),
        textEl: document.getElementById('annLetterText'),
        text: <%- JSON.stringify(card.fields.letterText) %>,
        onOpen: () => {
          const typedLength = <%- JSON.stringify(card.fields.letterText) %>.length;
          const revealDelay = prefersReducedMotion ? 0 : 500 + typedLength * 28 + 300;
          setTimeout(() => document.getElementById('annLetterSigned').classList.add('ann-visible'), revealDelay);
        },
      });

      // The envelope starts closed, but needs an explicit tap — give it a
      // gentle pulse so it's obvious it's interactive.
      document.getElementById('annEnvelope').classList.add('sc-tap-continue');
    }

    // --- Screen 5: Together Since ---
    const TOGETHER_YEAR = <%= togetherYear %>;
    let togetherStarted = false;
    let togetherTimer = null;

    function diffYearsMonthsDays(start, now) {
      let years = now.getFullYear() - start.getFullYear();
      let months = now.getMonth() - start.getMonth();
      let days = now.getDate() - start.getDate();
      if (days < 0) {
        months -= 1;
        const lastDayOfPrevMonth = new Date(now.getFullYear(), now.getMonth(), 0).getDate();
        days += lastDayOfPrevMonth;
        // A start day that doesn't exist in the borrowed month (e.g. Jan 31
        // borrowing from a 28/29-day February) can still leave days
        // negative — there's no exact calendar answer for that case, so
        // just clamp to 0 rather than ever displaying a negative number.
        if (days < 0) days = 0;
      }
      if (months < 0) {
        years -= 1;
        months += 12;
      }
      return { years: Math.max(years, 0), months: Math.max(months, 0), days: Math.max(days, 0) };
    }

    function startTogetherScreen() {
      if (togetherStarted) return;
      togetherStarted = true;

      const start = new Date(TOGETHER_YEAR, TOGETHER_MONTH, TOGETHER_DAY);
      const { years, months, days } = diffYearsMonthsDays(start, new Date());
      const parts = [];
      if (years > 0) parts.push(`${years} year${years === 1 ? '' : 's'}`);
      if (months > 0) parts.push(`${months} month${months === 1 ? '' : 's'}`);
      parts.push(`${days} day${days === 1 ? '' : 's'}`);
      const joined = parts.length > 1 ? `${parts.slice(0, -1).join(', ')} and ${parts[parts.length - 1]}` : parts[0];
      document.getElementById('togetherHeadline').textContent = `Together for ${joined} 💛`;

      const daysCounterEl = document.getElementById('daysCounter');
      function tickDaysCounter() {
        const totalDays = (Date.now() - start.getTime()) / 86400000;
        daysCounterEl.textContent = `${totalDays.toLocaleString(undefined, { minimumFractionDigits: 3, maximumFractionDigits: 3 })} days`;
      }
      tickDaysCounter();
      togetherTimer = setInterval(tickDaysCounter, prefersReducedMotion ? 60000 : 1000);
    }

    document.getElementById('reliveBtn').addEventListener('click', () => location.reload());
  </script>
</body>
</html>
