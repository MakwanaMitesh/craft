<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;700&family=DM+Sans:wght@400;500;600&family=Caveat:wght@500&display=swap"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/css/cards.css" />
  <style>
    body { margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 2rem 1rem; }
    .res-wrap { width: 100%; max-width: 440px; }
    .res-type { font-size: 13px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--rose); margin-bottom: 0.25rem; }
    .res-timeline { margin: 1.5rem 0; display: flex; flex-direction: column; gap: 1rem; }
    .res-step { display: flex; align-items: flex-start; gap: 0.75rem; }
    .res-icon {
      width: 36px; height: 36px; border-radius: 50%; background: var(--blush);
      display: flex; align-items: center; justify-content: center; font-size: 17px; flex-shrink: 0;
    }
    .res-step-label { font-weight: 600; font-size: 15px; }
    .res-step-time { font-size: 13px; opacity: 0.65; margin-top: 0.1rem; }
    .res-pending { opacity: 0.55; }
    .res-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
    .res-note { font-size: 12px; opacity: 0.55; margin-top: 1.5rem; text-align: center; }

    .res-live-dot {
      display: inline-block; width: 8px; height: 8px; border-radius: 50%;
      background: #2ecc71; margin-right: 5px; animation: res-live-pulse 1.4s ease-in-out infinite;
    }
    @keyframes res-live-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }
    @media (prefers-reduced-motion: reduce) { .res-live-dot { animation: none; } }
    .res-live-label { font-size: 12px; font-weight: 600; color: #2ecc71; margin-left: 0.5rem; }

    .res-answers { margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px dashed rgba(74,59,54,0.15); }
    .res-answers-title { font-weight: 600; font-size: 14px; margin-bottom: 0.75rem; }
    .res-answer-row { margin-bottom: 0.75rem; }
    .res-answer-q { font-size: 13px; opacity: 0.65; }
    .res-answer-a { font-size: 15px; font-weight: 600; }
    .res-answer-time { font-size: 12px; opacity: 0.5; }
  </style>
</head>
<body class="sc-root">
  <div class="res-wrap">
    <div class="sc-card sc-paper">
      <p class="res-type"><%= card.type[0].toUpperCase() + card.type.slice(1) %> card</p>
      <h1 class="sc-h1" style="margin-bottom: 0.25rem;">For <%= card.recipientName %></h1>
      <p class="sc-body" style="opacity: 0.7;">Here's how it's going — this page only refreshes for you.</p>

      <div class="res-timeline">
        <div class="res-step">
          <div class="res-icon">✉️</div>
          <div>
            <p class="res-step-label">Created</p>
            <p class="res-step-time"><%= card.createdAt.toLocaleString() %></p>
          </div>
        </div>

        <div class="res-step <%= card.openedAt ? '' : 'res-pending' %>">
          <div class="res-icon">👀</div>
          <div>
            <p class="res-step-label">Opened</p>
            <p class="res-step-time"><%= card.openedAt ? card.openedAt.toLocaleString() : 'Not opened yet' %></p>
          </div>
        </div>

        <% if (card.type === 'puzzle') { %>
          <div class="res-step" id="puzzleLiveStep">
            <div class="res-icon" id="puzzleStatusIcon">⏳</div>
            <div>
              <p class="res-step-label">
                <span id="puzzleStatusLabel">Not opened yet</span>
                <span id="liveDotWrap" style="display: none;"><span class="res-live-dot"></span><span class="res-live-label">Live</span></span>
              </p>
              <p class="res-step-time" id="puzzleStatsLine"></p>
            </div>
          </div>
        <% } else { %>
        <div class="res-step <%= card.recipientAnswer ? '' : 'res-pending' %>">
          <% if (card.recipientAnswer === 'yes') { %>
            <div class="res-icon">💛</div>
            <div>
              <p class="res-step-label">Answered "Yes"</p>
              <p class="res-step-time"><%= card.answeredAt.toLocaleString() %></p>
            </div>
          <% } else if (card.recipientAnswer === 'not_yet') { %>
            <div class="res-icon">🤔</div>
            <div>
              <p class="res-step-label">"Not yet"</p>
              <p class="res-step-time"><%= card.answeredAt.toLocaleString() %></p>
            </div>
          <% } else { %>
            <div class="res-icon">⏳</div>
            <div>
              <p class="res-step-label">No answer yet</p>
            </div>
          <% } %>
        </div>
        <% } %>
      </div>

      <% if (card.type === 'puzzle') { %>
        <div class="res-answers" id="puzzleAnswers" style="display: none;">
          <p class="res-answers-title">Answers</p>
          <div id="puzzleAnswersList"></div>
        </div>
      <% } %>

      <div class="res-actions">
        <button type="button" class="sc-btn" id="resCopy">Copy card link</button>
        <a href="#" class="sc-btn sc-btn-gold" id="resWhatsapp">Share again on WhatsApp</a>
      </div>
    </div>
    <p class="res-note" id="resNote">This page is private — only refreshes automatically every 30 seconds.</p>
  </div>

  <script src="/js/cardComponents.js"></script>
  <script>
    window.SurpriseCard.wireShareScreen({
      copyBtn: document.getElementById('resCopy'),
      whatsappBtn: document.getElementById('resWhatsapp'),
      shareUrl: <%- JSON.stringify(shareUrl) %>,
      whatsappText: 'I made something for you 💛',
    });

    <% if (card.type === 'puzzle') { %>
      // Puzzle cards get live 5-second polling instead of a 30-second full
      // reload — the recipient's own puzzle screen is what actually writes
      // the progress this reads (see recordPuzzleProgress/getPuzzleLiveStatus
      // in controllers/surpriseCardsController.js).
      const SLUG = <%- JSON.stringify(card.slug) %>;
      const KEY = <%- JSON.stringify(card.resultsKey) %>;
      document.getElementById('resNote').textContent = 'This page is private — updates live while they play.';

      function formatTime(total) {
        const m = Math.floor(total / 60);
        const s = total % 60;
        return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
      }

      function renderAnswers(questions, answers) {
        const list = document.getElementById('puzzleAnswersList');
        const keys = Object.keys(answers || {}).map(Number).sort((a, b) => a - b);
        if (!keys.length) {
          document.getElementById('puzzleAnswers').style.display = 'none';
          return;
        }
        document.getElementById('puzzleAnswers').style.display = 'block';
        list.innerHTML = '';
        keys.forEach((i) => {
          const a = answers[i];
          const row = document.createElement('div');
          row.className = 'res-answer-row';

          // Built with textContent, not innerHTML — the question text and
          // answer both ultimately trace back to recipient-submitted input
          // and must never be interpreted as HTML on this page.
          const q = document.createElement('p');
          q.className = 'res-answer-q';
          q.textContent = a.text;
          const ans = document.createElement('p');
          ans.className = 'res-answer-a';
          ans.textContent = a.answer;
          const time = document.createElement('p');
          time.className = 'res-answer-time';
          time.textContent = new Date(a.answeredAt).toLocaleString();

          row.appendChild(q);
          row.appendChild(ans);
          row.appendChild(time);
          list.appendChild(row);
        });
      }

      async function pollLive() {
        try {
          const res = await fetch(`/c/${SLUG}/results/live?key=${encodeURIComponent(KEY)}`);
          const data = await res.json();
          if (!data.success) return;

          const icon = document.getElementById('puzzleStatusIcon');
          const label = document.getElementById('puzzleStatusLabel');
          const stats = document.getElementById('puzzleStatsLine');
          const liveDotWrap = document.getElementById('liveDotWrap');

          liveDotWrap.style.display = data.isLiveNow ? 'inline' : 'none';

          if (data.status === 'solved' && data.solveStats) {
            icon.textContent = '🎉';
            label.textContent = 'Solved! 🎉';
            stats.textContent = `${data.solveStats.moves} moves · ${formatTime(data.solveStats.timeSeconds)} · ${data.solveStats.peeks} peek${data.solveStats.peeks === 1 ? '' : 's'}`;
          } else if (data.status === 'playing') {
            icon.textContent = '🧩';
            label.textContent = 'Playing now 🧩';
            stats.textContent = data.current ? `Moves: ${data.current.moves} · ${formatTime(data.current.timeSeconds)}` : 'Just started…';
          } else {
            icon.textContent = '⏳';
            label.textContent = 'Not opened yet';
            stats.textContent = '';
          }

          renderAnswers(data.questions, data.answers);
        } catch {
          // A missed poll just means the next one (5s later) catches up —
          // nothing to show the sender for a single dropped request.
        }
      }

      pollLive();
      setInterval(pollLive, 5000);
    <% } else { %>
      setTimeout(() => location.reload(), 30000);
    <% } %>
  </script>
</body>
</html>
