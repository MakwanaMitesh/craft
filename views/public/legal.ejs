<%- include('../layouts/main-head', { title }) %>

<div class="max-w-2xl mx-auto card-panel">
  <h1 class="text-2xl font-semibold mb-4"><%= pageTitle %></h1>
  <div class="prose prose-stone max-w-none text-stone-600 space-y-4">
    <% if (html) { %>
      <%- html %>
    <% } else { %>
      <% paragraphs.forEach(p => { %>
        <p><%= p %></p>
      <% }) %>
    <% } %>
  </div>
  <p class="text-sm text-stone-400 mt-8 border-t border-amber-100 pt-4">
    Questions? Reach us at <a href="mailto:<%= settings.supportEmail %>" class="text-amber-700 font-semibold"><%= settings.supportEmail %></a>.
  </p>
</div>

<%- include('../layouts/main-foot') %>
