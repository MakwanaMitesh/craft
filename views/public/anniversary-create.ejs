<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,700;1,500&family=DM+Sans:wght@400;500;600&family=Caveat:wght@500&display=swap"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/css/cards.css" />
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>
  <style>
    /* --- Anniversary theme override: everything else is inherited from cards.css --- */
    .theme-anniversary {
      --gold: #C9A86A;   /* champagne gold — primary accent/borders for this card only */
      --rose: #D8A7A7;   /* dusty rose — buttons for this card only */
      --cocoa: #3E2F2B;  /* deeper text tone for this card only */
      background: #FBF6EE;
      min-height: 100vh;
      margin: 0;
    }
    .an-italic { font-family: var(--font-heading); font-style: italic; }

    .an-wrap { max-width: 1040px; margin: 0 auto; padding: 3rem 1.5rem 5rem; }
    .an-hero { text-align: center; max-width: 560px; margin: 0 auto 2.5rem; }
    .an-hero p { opacity: 0.8; margin-top: 0.75rem; }

    .an-grid { display: grid; gap: 2rem; grid-template-columns: 1fr; }
    @media (min-width: 900px) {
      .an-grid { grid-template-columns: 1.1fr 0.9fr; align-items: start; }
      .an-preview-col { position: sticky; top: 2rem; }
    }

    .an-field { margin-bottom: 1.5rem; }
    .an-label { display: block; font-weight: 600; margin-bottom: 0.4rem; font-size: 15px; }
    .an-hint { font-size: 13px; opacity: 0.65; margin-top: 0.3rem; }
    .an-error { font-size: 13px; color: #B3404A; margin-top: 0.3rem; display: none; }
    .an-error.an-show { display: block; }
    .an-input, .an-textarea {
      width: 100%;
      font-family: var(--font-body);
      font-size: 16px;
      padding: 0.8rem 1rem;
      border-radius: 14px;
      border: 1.5px solid rgba(62,47,43,0.15);
      background: var(--white-soft);
      color: var(--cocoa);
      box-sizing: border-box;
      transition: border-color 200ms var(--ease-soft);
    }
    .an-input:focus, .an-textarea:focus { outline: none; border-color: var(--gold); }
    .an-textarea { resize: vertical; min-height: 90px; }
    .an-count { font-size: 12px; opacity: 0.55; text-align: right; margin-top: 0.25rem; }

    .an-anniversary-callout {
      font-size: 1.1rem; margin-top: 0.5rem; color: var(--gold); min-height: 1.4rem;
    }

    .an-illustrations { display: flex; gap: 1rem; flex-wrap: wrap; }
    .an-illustration-option { cursor: pointer; text-align: center; }
    .an-illustration-option input { position: absolute; opacity: 0; pointer-events: none; }
    .an-illustration-card {
      width: 110px; padding: 0.6rem; border-radius: 16px; border: 2px solid transparent;
      background: var(--white-soft); box-shadow: var(--shadow-soft);
      transition: border-color 200ms var(--ease-soft), transform 200ms var(--ease-soft);
    }
    .an-illustration-option input:checked + .an-illustration-card { border-color: var(--gold); transform: translateY(-3px); }
    .an-illustration-card svg { width: 100%; height: 56px; }
    .an-illustration-card span { display: block; font-size: 11px; margin-top: 0.4rem; font-weight: 500; }

    /* --- Love lines (up to 5) --- */
    .an-love-row { display: flex; gap: 0.5rem; margin-bottom: 0.6rem; }
    .an-love-row .an-input { flex: 1; }
    .an-remove-btn {
      width: 40px; flex-shrink: 0; border-radius: 10px; border: 1.5px solid rgba(62,47,43,0.15);
      background: var(--white-soft); color: #B3404A; cursor: pointer; font-size: 16px;
    }

    /* --- Timeline moments (up to 8, draggable) --- */
    .an-timeline-row {
      background: var(--white-soft); border-radius: 14px; box-shadow: var(--shadow-soft);
      padding: 1rem; margin-bottom: 0.9rem; display: flex; gap: 0.75rem; align-items: flex-start;
    }
    .an-timeline-row.an-dragging { opacity: 0.4; }
    .an-drag-handle { cursor: grab; font-size: 18px; opacity: 0.4; padding-top: 0.5rem; user-select: none; }
    .an-timeline-fields { flex: 1; }
    .an-timeline-fields .an-input, .an-timeline-fields .an-textarea { margin-bottom: 0.5rem; }
    .an-timeline-fields .an-textarea { min-height: 50px; }
    .an-timeline-photo {
      width: 56px; height: 56px; border-radius: 10px; border: 1.5px dashed rgba(62,47,43,0.25);
      display: flex; align-items: center; justify-content: center; font-size: 18px; color: var(--gold);
      cursor: pointer; position: relative; overflow: hidden; background: var(--cream); flex-shrink: 0;
    }
    .an-timeline-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .an-timeline-photo input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }

    /* --- Live preview panel (phone-mockup style) --- */
    .an-phone { width: 100%; max-width: 300px; margin: 0 auto; background: #1c1917; border-radius: 2.25rem; padding: 12px; box-shadow: var(--shadow-soft); }
    .an-phone-screen {
      border-radius: 1.75rem; overflow: hidden; min-height: 480px; background: #FBF6EE;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      padding: 2rem 1.25rem; text-align: center; gap: 0.6rem;
    }
    .an-phone-illustration svg { width: 120px; height: 90px; }
    .an-phone-anniversary { font-weight: 600; color: var(--gold); }
    .an-phone-letter { font-family: var(--font-hand); font-size: 1.2rem; line-height: 1.4; max-height: 130px; overflow: hidden; }

    .an-submit-row { margin-top: 1rem; text-align: center; }

    /* --- Full-screen overlay (loading + share) --- */
    .an-overlay { position: fixed; inset: 0; z-index: 50; display: none; }
    .an-overlay.an-overlay-visible { display: block; }
    .an-loading-heart { animation: an-pulse 1.1s ease-in-out infinite; }
    @keyframes an-pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.15); } }
    @media (prefers-reduced-motion: reduce) {
      .an-loading-heart { animation: none; }
    }
  </style>
</head>
<body class="sc-root theme-anniversary">

  <div class="an-wrap">
    <div class="an-hero">
      <h1>Celebrate your love story 💍</h1>
      <p class="sc-body">Relive your journey together, one moment at a time.</p>
    </div>

    <form id="anniversaryForm" class="an-grid" novalidate>
      <div class="an-form-col">

        <div class="an-field">
          <label class="an-label" for="yourName">Your name</label>
          <input class="an-input" type="text" id="yourName" name="yourName" maxlength="30" required />
          <p class="an-error" data-error-for="yourName"></p>
        </div>

        <div class="an-field">
          <label class="an-label" for="theirName">Their name</label>
          <input class="an-input" type="text" id="theirName" name="theirName" maxlength="30" required />
          <p class="an-error" data-error-for="theirName"></p>
        </div>

        <div class="an-field">
          <label class="an-label" for="togetherDate">Date you got together / got married</label>
          <input class="an-input" type="date" id="togetherDate" name="togetherDate" required />
          <p class="an-anniversary-callout an-italic" id="anniversaryCallout"></p>
          <p class="an-error" data-error-for="togetherDate"></p>
        </div>

        <div class="an-field">
          <label class="an-label">Couple illustration style</label>
          <div class="an-illustrations">
            <% const styleLabels = { handholding: 'Holding hands', umbrella: 'Under an umbrella', coffee: 'Two coffees' }; %>
            <% illustrationStyles.forEach((s, i) => { %>
              <label class="an-illustration-option">
                <input type="radio" name="illustrationStyle" value="<%= s %>" <%= i === 0 ? 'checked' : '' %> required />
                <div class="an-illustration-card">
                  <%- include('../partials/couple-illustration-svg', { style: s }) %>
                  <span><%= styleLabels[s] %></span>
                </div>
              </label>
            <% }) %>
          </div>
          <p class="an-error" data-error-for="illustrationStyle"></p>
        </div>

        <div class="an-field">
          <label class="an-label">Love story timeline <span class="an-hint">(optional, up to <%= maxTimelineMoments %>, drag to reorder)</span></label>
          <div id="timelineList"></div>
          <button type="button" class="sc-btn sc-btn-outline" id="addMomentBtn" style="font-size: 14px; padding: 0.6rem 1.25rem;">+ Add moment</button>
          <p class="an-error" data-error-for="timeline"></p>
        </div>

        <div class="an-field">
          <label class="an-label">Things I love about you <span class="an-hint">(optional, up to <%= maxLoveLines %>)</span></label>
          <div id="loveLinesList"></div>
          <button type="button" class="sc-btn sc-btn-outline" id="addLoveLineBtn" style="font-size: 14px; padding: 0.6rem 1.25rem;">+ Add a line</button>
        </div>

        <div class="an-field">
          <label class="an-label" for="letterText">Your anniversary letter</label>
          <textarea class="an-textarea" id="letterText" name="letterText" maxlength="1200" placeholder="Write from the heart..." required style="min-height: 140px;"></textarea>
          <p class="an-count" data-count-for="letterText">0 / 1200</p>
          <p class="an-error" data-error-for="letterText"></p>
        </div>

        <div class="an-submit-row">
          <button type="submit" class="sc-btn" id="submitBtn">Create our anniversary card 💍</button>
        </div>
      </div>

      <div class="an-preview-col">
        <p class="an-label" style="text-align: center; margin-bottom: 0.75rem;">Live preview</p>
        <div class="an-phone">
          <div class="an-phone-screen">
            <div class="an-phone-illustration" id="previewIllustration">
              <%- include('../partials/couple-illustration-svg', { style: illustrationStyles[0] }) %>
            </div>
            <p class="an-phone-anniversary an-italic" id="previewAnniversary">Pick a date to see your anniversary ✨</p>
            <p class="an-phone-letter" id="previewLetter">Your letter will appear here...</p>
          </div>
        </div>
      </div>
    </form>
  </div>

  <!-- Hidden templates — cloned by JS, never submitted themselves -->
  <template id="timelineRowTemplate">
    <div class="an-timeline-row" draggable="true">
      <span class="an-drag-handle">⠿</span>
      <div class="an-timeline-fields">
        <input class="an-input" type="text" name="timelineDate" maxlength="40" placeholder="Date or label (e.g. First date)" />
        <textarea class="an-textarea" name="timelineCaption" maxlength="120" placeholder="A short caption..."></textarea>
      </div>
      <label class="an-timeline-photo">
        <span>+</span>
        <input type="file" accept="image/jpeg,image/png,image/webp" class="an-timeline-photo-input" />
      </label>
      <button type="button" class="an-remove-btn" title="Remove moment">✕</button>
    </div>
  </template>

  <template id="loveLineRowTemplate">
    <div class="an-love-row">
      <input class="an-input" type="text" name="loveLines" maxlength="100" placeholder="e.g. The way you laugh at your own jokes" />
      <button type="button" class="an-remove-btn" title="Remove line">✕</button>
    </div>
  </template>

  <!-- ===== Full-screen overlay: loading -> share ===== -->
  <div class="an-overlay sc-screen-container" id="overlay">
    <div class="sc-screen" id="screen-loading">
      <div class="an-loading-heart" style="font-size: 3rem;">💍</div>
      <h2>Wrapping up your story…</h2>
    </div>

    <div class="sc-screen" id="screen-share">
      <div class="sc-card sc-paper" style="max-width: 420px;">
        <h2 style="margin-bottom: 0.5rem;">It's ready to send 💍</h2>
        <p class="sc-body" id="shareSubtitle" style="opacity: 0.8; margin-bottom: 1rem;"></p>
        <p class="sc-body" style="word-break: break-all; opacity: 0.7; font-size: 14px;" id="shareUrlText"></p>
        <div class="sc-share-row" style="margin: 1.25rem 0;">
          <button type="button" class="sc-btn" id="overlayCopy">Copy link</button>
          <a href="#" class="sc-btn sc-btn-gold" id="overlayWhatsapp">Send on WhatsApp</a>
          <a href="#" class="sc-btn sc-btn-outline" id="overlayPreview">Preview</a>
        </div>
        <div class="sc-qr-box">
          <img src="" alt="QR code to the card" id="overlayQr" />
        </div>

        <div style="margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px dashed rgba(62,47,43,0.2);">
          <p class="an-label" style="color: var(--gold); margin-bottom: 0.4rem;">Your private link</p>
          <p class="sc-body" style="font-size: 13px; opacity: 0.7; margin-bottom: 0.75rem;">
            See when it's opened — keep this link to yourself, don't send it to <span id="shareRecipientName">them</span>.
          </p>
          <div class="sc-share-row">
            <a href="#" class="sc-btn sc-btn-outline" id="overlayResults" target="_blank" rel="noopener">View status 📊</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/cardComponents.js"></script>
  <script>
    const S = window.SurpriseCard;
    const MAX_TIMELINE_MOMENTS = <%= maxTimelineMoments %>;
    const MAX_LOVE_LINES = <%= maxLoveLines %>;

    // --- Character counter ---
    const letterEl = document.getElementById('letterText');
    const letterCounter = document.querySelector('[data-count-for="letterText"]');
    letterEl.addEventListener('input', () => {
      letterCounter.textContent = `${letterEl.value.length} / 1200`;
      updatePreview();
    });

    // --- Illustration style svgs (for live preview) ---
    const illustrationSvgs = {};
    document.querySelectorAll('.an-illustration-card svg').forEach((svg, i) => {
      const input = document.querySelectorAll('input[name="illustrationStyle"]')[i];
      if (input) illustrationSvgs[input.value] = svg.outerHTML;
    });
    document.querySelectorAll('input[name="illustrationStyle"]').forEach((r) => r.addEventListener('change', updatePreview));

    // --- Anniversary number calculation (mirrors utils/ordinal.js server-side) ---
    function ordinalSuffix(n) {
      const s = ['th', 'st', 'nd', 'rd'];
      const v = n % 100;
      return `${n}${s[(v - 20) % 10] || s[v] || s[0]}`;
    }
    function calcAnniversaryNumber(togetherDate, today) {
      let years = today.getFullYear() - togetherDate.getFullYear();
      const monthDiff = today.getMonth() - togetherDate.getMonth();
      const dayDiff = today.getDate() - togetherDate.getDate();
      if (monthDiff < 0 || (monthDiff === 0 && dayDiff < 0)) years -= 1;
      return Math.max(years, 0) + 1;
    }

    const togetherDateInput = document.getElementById('togetherDate');
    const anniversaryCallout = document.getElementById('anniversaryCallout');
    togetherDateInput.addEventListener('input', () => {
      const val = togetherDateInput.value;
      if (!val) { anniversaryCallout.textContent = ''; updatePreview(); return; }
      const togetherDate = new Date(val);
      if (Number.isNaN(togetherDate.getTime()) || togetherDate > new Date()) {
        anniversaryCallout.textContent = '';
        updatePreview();
        return;
      }
      const n = calcAnniversaryNumber(togetherDate, new Date());
      anniversaryCallout.textContent = `This will be your ${ordinalSuffix(n)} anniversary ✨`;
      updatePreview();
    });

    // --- Live preview ---
    function updatePreview() {
      const style = document.querySelector('input[name="illustrationStyle"]:checked')?.value;
      if (style && illustrationSvgs[style]) document.getElementById('previewIllustration').innerHTML = illustrationSvgs[style];
      document.getElementById('previewAnniversary').textContent =
        anniversaryCallout.textContent || 'Pick a date to see your anniversary ✨';
      document.getElementById('previewLetter').textContent =
        letterEl.value.trim() || 'Your letter will appear here...';
    }
    updatePreview();

    // --- Love lines (dynamic, up to MAX_LOVE_LINES) ---
    const loveLinesList = document.getElementById('loveLinesList');
    const loveLineTemplate = document.getElementById('loveLineRowTemplate');
    const addLoveLineBtn = document.getElementById('addLoveLineBtn');

    function addLoveLine() {
      if (loveLinesList.children.length >= MAX_LOVE_LINES) return;
      const wrapper = document.createElement('div');
      wrapper.innerHTML = loveLineTemplate.innerHTML.trim();
      loveLinesList.appendChild(wrapper.firstChild);
      addLoveLineBtn.style.display = loveLinesList.children.length >= MAX_LOVE_LINES ? 'none' : '';
    }
    addLoveLineBtn.addEventListener('click', addLoveLine);
    loveLinesList.addEventListener('click', (e) => {
      if (e.target.classList.contains('an-remove-btn')) {
        e.target.closest('.an-love-row').remove();
        addLoveLineBtn.style.display = '';
      }
    });
    addLoveLine(); // start with one empty line, same "already has a row" feel as the apology form's photo slots

    // --- Timeline moments (dynamic, up to MAX_TIMELINE_MOMENTS, drag to reorder) ---
    const timelineList = document.getElementById('timelineList');
    const timelineTemplate = document.getElementById('timelineRowTemplate');
    const addMomentBtn = document.getElementById('addMomentBtn');
    const timelinePhotoFiles = new Map(); // row element -> File

    function renumberTimelinePhotoNames() {
      Array.from(timelineList.children).forEach((row, i) => {
        const input = row.querySelector('.an-timeline-photo-input');
        if (input) input.name = `timelinePhoto_${i}`;
      });
    }

    function wireTimelineRow(row) {
      const photoInput = row.querySelector('.an-timeline-photo-input');
      photoInput.addEventListener('change', () => {
        const file = photoInput.files[0];
        timelinePhotoFiles.set(row, file || null);
        const slot = photoInput.closest('.an-timeline-photo');
        slot.querySelectorAll('img').forEach((img) => img.remove());
        if (file) {
          const img = document.createElement('img');
          img.src = URL.createObjectURL(file);
          slot.prepend(img);
        }
      });

      row.querySelector('.an-remove-btn').addEventListener('click', () => {
        timelinePhotoFiles.delete(row);
        row.remove();
        renumberTimelinePhotoNames();
        addMomentBtn.style.display = timelineList.children.length >= MAX_TIMELINE_MOMENTS ? 'none' : '';
      });

      // Native HTML5 drag-and-drop reorder.
      row.addEventListener('dragstart', () => row.classList.add('an-dragging'));
      row.addEventListener('dragend', () => {
        row.classList.remove('an-dragging');
        renumberTimelinePhotoNames();
      });
    }

    timelineList.addEventListener('dragover', (e) => {
      e.preventDefault();
      const dragging = timelineList.querySelector('.an-dragging');
      if (!dragging) return;
      const afterElement = [...timelineList.children].find((el) => {
        if (el === dragging) return false;
        const rect = el.getBoundingClientRect();
        return e.clientY < rect.top + rect.height / 2;
      });
      if (afterElement) timelineList.insertBefore(dragging, afterElement);
      else timelineList.appendChild(dragging);
    });

    function addTimelineMoment() {
      if (timelineList.children.length >= MAX_TIMELINE_MOMENTS) return;
      const wrapper = document.createElement('div');
      wrapper.innerHTML = timelineTemplate.innerHTML.trim();
      const row = wrapper.firstChild;
      timelineList.appendChild(row);
      wireTimelineRow(row);
      renumberTimelinePhotoNames();
      addMomentBtn.style.display = timelineList.children.length >= MAX_TIMELINE_MOMENTS ? 'none' : '';
    }
    addMomentBtn.addEventListener('click', addTimelineMoment);
    addTimelineMoment();

    // --- Validation ---
    function showErrors(errors) {
      document.querySelectorAll('.an-error').forEach((el) => { el.classList.remove('an-show'); el.textContent = ''; });
      Object.entries(errors || {}).forEach(([field, message]) => {
        const el = document.querySelector(`[data-error-for="${field}"]`);
        if (el) { el.textContent = message; el.classList.add('an-show'); }
      });
    }

    function clientValidate() {
      const errors = {};
      if (!document.getElementById('yourName').value.trim()) errors.yourName = 'Your name is required.';
      if (!document.getElementById('theirName').value.trim()) errors.theirName = 'Their name is required.';
      if (!togetherDateInput.value) errors.togetherDate = 'Pick the date you got together.';
      if (!letterEl.value.trim()) errors.letterText = 'Write your anniversary letter.';
      return errors;
    }

    // --- Submit flow: form -> loading overlay -> share overlay ---
    const overlay = document.getElementById('overlay');

    document.getElementById('anniversaryForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const clientErrors = clientValidate();
      if (Object.keys(clientErrors).length) { showErrors(clientErrors); return; }
      showErrors({});

      overlay.classList.add('an-overlay-visible');
      const overlayScreens = S.createScreenContainer(overlay);
      overlayScreens.goTo(0);

      const formData = new FormData();
      formData.append('yourName', document.getElementById('yourName').value.trim());
      formData.append('theirName', document.getElementById('theirName').value.trim());
      formData.append('togetherDate', togetherDateInput.value);
      formData.append('illustrationStyle', document.querySelector('input[name="illustrationStyle"]:checked')?.value || '');
      formData.append('letterText', letterEl.value.trim());

      document.querySelectorAll('#loveLinesList input[name="loveLines"]').forEach((input) => {
        if (input.value.trim()) formData.append('loveLines', input.value.trim());
      });

      Array.from(timelineList.children).forEach((row, i) => {
        formData.append('timelineDate', row.querySelector('input[name="timelineDate"]').value.trim());
        formData.append('timelineCaption', row.querySelector('textarea[name="timelineCaption"]').value.trim());
        const file = timelinePhotoFiles.get(row);
        if (file) formData.append(`timelinePhoto_${i}`, file);
      });

      try {
        const res = await fetch('/cards/anniversary/create', {
          method: 'POST',
          headers: { 'X-CSRF-Token': <%- JSON.stringify(csrfToken) %> },
          body: formData,
        });
        const data = await res.json();

        if (!data.success) {
          overlay.classList.remove('an-overlay-visible');
          showErrors(data.errors || {});
          return;
        }

        setTimeout(() => {
          document.getElementById('shareSubtitle').textContent = data.whatsappPreviewTitle;
          document.getElementById('shareUrlText').textContent = data.shareUrl;
          document.getElementById('overlayQr').src = data.qrDataUrl;
          document.getElementById('shareRecipientName').textContent = data.recipientName;
          document.getElementById('overlayResults').setAttribute('href', data.resultsUrl);
          S.wireShareScreen({
            copyBtn: document.getElementById('overlayCopy'),
            whatsappBtn: document.getElementById('overlayWhatsapp'),
            previewBtn: document.getElementById('overlayPreview'),
            shareUrl: data.shareUrl,
            whatsappText: 'Happy anniversary, my love 💍 Open this:',
          });
          overlayScreens.next();
          S.burstConfetti({ colors: ['#C9A86A', '#D8A7A7', '#FBF6EE'] });
        }, 1400);
      } catch (err) {
        overlay.classList.remove('an-overlay-visible');
        showErrors({ yourName: 'Something went wrong sending this. Please try again.' });
      }
    });
  </script>
</body>
</html>
