<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <meta name="description" content="A little surprise for <%= card.recipientName %>." />
  <!-- Deliberately generic Open Graph text and no image — the real photo
       and message are the whole surprise, so a WhatsApp/Instagram link
       preview must never show either of them. -->
  <meta property="og:title" content="<%= title %>" />
  <meta property="og:description" content="Tap to play." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;700&family=DM+Sans:wght@400;500;600&family=Caveat:wght@500;600&display=swap"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/css/cards.css" />
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>
  <style>
    html, body { height: 100%; margin: 0; overflow: hidden; }
    .theme-puzzle {
      --rose: #F28C7A;
      --gold: #FFE5A0;
      background-color: var(--cream);
      background-image: radial-gradient(rgba(74,59,54,0.08) 1.5px, transparent 1.5px);
      background-size: 18px 18px;
      height: 100%;
    }

    /* ===== Screen 1: The Challenge ===== */
    .pzr-lock-wrap { font-size: 4rem; animation: pzr-wiggle 2.2s ease-in-out infinite; }
    @keyframes pzr-wiggle {
      0%, 100% { transform: rotate(0deg); }
      8% { transform: rotate(-8deg); }
      16% { transform: rotate(7deg); }
      24% { transform: rotate(-5deg); }
      32% { transform: rotate(3deg); }
      40% { transform: rotate(0deg); }
    }
    .pzr-lock-wrap.pzr-unlocked { animation: none; display: inline-block; }
    .pzr-lock-wrap.pzr-unlock-anim { animation: pzr-unlock-pop 700ms var(--ease-soft) forwards; }
    @keyframes pzr-unlock-pop {
      0% { transform: rotate(0deg) scale(1); }
      40% { transform: rotate(-18deg) scale(1.15); }
      70% { transform: rotate(8deg) scale(1.1); }
      100% { transform: rotate(0deg) scale(1); }
    }
    @media (prefers-reduced-motion: reduce) {
      .pzr-lock-wrap { animation: none; }
      .pzr-lock-wrap.pzr-unlock-anim { animation: none; }
    }

    /* ===== Screen 2: The Puzzle ===== */
    .pzr-puzzle-screen { justify-content: flex-start !important; padding-top: 1.25rem !important; gap: 0.75rem; }
    .pzr-topbar {
      width: 100%; max-width: 480px; display: flex; align-items: center; justify-content: space-between;
      font-family: var(--font-body); font-weight: 600; font-size: 15px; padding: 0 16px; box-sizing: border-box;
    }
    .pzr-stats { opacity: 0.8; }

    .pzr-board-wrap { width: 100%; max-width: 480px; padding: 0 16px; box-sizing: border-box; }
    .pzr-board {
      width: 100%; aspect-ratio: 1 / 1; display: grid; gap: 2px;
      background: var(--cocoa); border-radius: 10px; overflow: hidden;
      box-shadow: var(--shadow-soft); position: relative;
      transition: gap 500ms var(--ease-soft);
    }
    .pzr-board.pzr-solved-board { gap: 0; }
    .pzr-tile {
      background-repeat: no-repeat; border-radius: 6px; cursor: pointer;
      position: relative; transition: box-shadow 250ms var(--ease-soft);
      touch-action: none;
    }
    .pzr-board.pzr-solved-board .pzr-tile { border-radius: 0; cursor: default; }
    .pzr-tile.pzr-selected { box-shadow: 0 0 0 3px var(--rose), 0 6px 14px rgba(0,0,0,0.25); transform: scale(0.96); z-index: 2; }
    .pzr-tile.pzr-correct-glow { animation: pzr-correct-pulse 900ms var(--ease-soft); }
    @keyframes pzr-correct-pulse {
      0% { box-shadow: 0 0 0 0 rgba(191,215,234,0.9); }
      60% { box-shadow: 0 0 0 8px rgba(191,215,234,0); }
      100% { box-shadow: 0 0 0 0 rgba(191,215,234,0); }
    }
    .pzr-shine {
      position: absolute; inset: 0; pointer-events: none; z-index: 3; opacity: 0;
      background: linear-gradient(115deg, transparent 30%, rgba(255,255,255,0.75) 48%, transparent 66%);
      background-size: 250% 100%; background-position: -40% 0;
    }
    .pzr-shine.pzr-shine-run {
      opacity: 1;
      animation: pzr-shine-sweep 1100ms ease-out forwards;
    }
    @keyframes pzr-shine-sweep {
      0% { background-position: -60% 0; opacity: 1; }
      85% { background-position: 110% 0; opacity: 1; }
      100% { background-position: 110% 0; opacity: 0; }
    }
    @media (prefers-reduced-motion: reduce) {
      .pzr-tile.pzr-correct-glow { animation: none; }
      .pzr-shine.pzr-shine-run { animation: none; opacity: 0; }
      .pzr-board { transition: none; }
    }

    .pzr-actions-row { display: flex; gap: 0.75rem; }
    .pzr-small-btn {
      font-family: var(--font-body); font-size: 13px; font-weight: 600;
      padding: 0.55rem 1rem; border-radius: 999px; border: 1.5px solid rgba(74,59,54,0.18);
      background: var(--white-soft); color: var(--cocoa); cursor: pointer;
    }

    .pzr-peek-overlay {
      position: fixed; inset: 0; z-index: 40; background: rgba(28,25,23,0.92);
      display: flex; align-items: center; justify-content: center; opacity: 0; pointer-events: none;
      transition: opacity 200ms var(--ease-soft);
    }
    .pzr-peek-overlay.pzr-peek-visible { opacity: 1; pointer-events: auto; }
    .pzr-peek-overlay img { max-width: 86vw; max-height: 70vh; border-radius: 14px; box-shadow: var(--shadow-soft); }
    .pzr-peek-label { position: absolute; top: 2rem; color: #fff; font-weight: 600; }

    .pzr-solved-text { text-align: center; }
    .pzr-solved-text h2 { margin-bottom: 0.25rem; }

    /* ===== Screen 3: The Surprise ===== */
    .pzr-reveal-card { max-width: 420px; text-align: center; }
    .pzr-polaroid {
      background: #fff; padding: 10px 10px 18px; border-radius: 10px;
      box-shadow: var(--shadow-soft); display: inline-block; transform: rotate(-1.5deg); margin-bottom: 1.25rem;
    }
    .pzr-polaroid img { width: 220px; height: 220px; object-fit: cover; border-radius: 6px; display: block; }
    .pzr-reveal-message {
      font-family: var(--font-hand); font-size: clamp(24px, 6vw, 32px); line-height: 1.4;
      margin: 0.5rem 0; white-space: pre-wrap; min-height: 1.4em;
    }
    .pzr-reveal-signature {
      font-family: var(--font-hand); font-size: 22px; opacity: 0; margin-top: 0.75rem;
      transition: opacity 500ms var(--ease-soft);
    }
    .pzr-reveal-signature.pzr-visible { opacity: 0.85; }
    .pzr-letter-caret {
      display: inline-block; width: 2px; height: 1em; background: var(--cocoa);
      margin-left: 1px; vertical-align: middle; animation: pzr-caret-blink 0.9s steps(1) infinite;
    }
    @keyframes pzr-caret-blink { 50% { opacity: 0; } }
    .pzr-next-row { margin-top: 1.25rem; }

    /* ===== Screen 4: Questions ===== */
    .pzr-q-progress {
      font-family: var(--font-body); font-size: 13px; font-weight: 600; letter-spacing: 0.06em;
      text-transform: uppercase; opacity: 0.6; margin-bottom: 0.75rem;
    }
    .pzr-q-text { font-family: var(--font-heading); font-size: clamp(22px, 5.5vw, 28px); max-width: 420px; margin-bottom: 1.5rem; }
    .pzr-q-yesno { display: flex; gap: 1rem; }
    .pzr-q-yesno button { min-width: 110px; padding: 1rem 1.5rem; font-size: 17px; }
    .pzr-q-options { display: flex; flex-direction: column; gap: 0.75rem; width: 100%; max-width: 360px; }
    .pzr-q-option-card {
      font-family: var(--font-body); font-size: 16px; font-weight: 500; text-align: center;
      padding: 1rem; border-radius: 14px; border: 1.5px solid rgba(74,59,54,0.18);
      background: var(--white-soft); cursor: pointer; transition: all 200ms var(--ease-soft);
    }
    .pzr-q-option-card:active { transform: scale(0.97); background: var(--sky, #BFD7EA); }
    .pzr-q-short { display: flex; flex-direction: column; gap: 0.75rem; width: 100%; max-width: 360px; }
    .pzr-q-short textarea {
      width: 100%; font-family: var(--font-body); font-size: 16px; padding: 0.9rem 1rem;
      border-radius: 14px; border: 1.5px solid rgba(74,59,54,0.18); background: var(--white-soft);
      color: var(--cocoa); box-sizing: border-box; resize: none; min-height: 90px;
    }
    .pzr-q-short-count { font-size: 12px; opacity: 0.55; text-align: right; }
    .pzr-q-sent { text-align: center; }
    .pzr-final-buttons { display: flex; gap: 1rem; margin-top: 1.5rem; flex-wrap: wrap; justify-content: center; }
  </style>
</head>
<body class="sc-root theme-puzzle">

  <div class="sc-screen-container">

    <!-- SCREEN 1: The Challenge -->
    <div class="sc-screen" id="screen-challenge">
      <div class="pzr-lock-wrap" id="lockIcon1">🔒</div>
      <h1 class="sc-h1" style="margin-top: 0.5rem;"><%= card.recipientName %>, your surprise is locked 🔒</h1>
      <p class="sc-body" style="opacity: 0.75;">Solve the puzzle to unlock it</p>
      <button type="button" class="sc-btn" id="playBtn" style="margin-top: 1rem;">Let's play 🧩</button>
    </div>

    <!-- SCREEN 2: The Puzzle -->
    <div class="sc-screen pzr-puzzle-screen" id="screen-puzzle">
      <div class="pzr-topbar">
        <span class="pzr-stats" id="statsLine">Moves: 0 · 00:00</span>
        <span id="lockIcon2" style="font-size: 1.4rem;">🔒</span>
      </div>

      <div class="pzr-board-wrap">
        <div class="pzr-board" id="board"></div>
      </div>

      <div class="pzr-actions-row" id="gameActions">
        <button type="button" class="pzr-small-btn" id="peekBtn">Peek 👀</button>
        <button type="button" class="pzr-small-btn" id="shuffleBtn">Shuffle again</button>
      </div>

      <div class="pzr-solved-text" id="solvedText" style="display: none;">
        <h2 id="solvedHeadline">You did it! 🎉</h2>
        <button type="button" class="sc-btn" id="unlockBtn">Unlock my surprise 🔓</button>
      </div>
    </div>

    <!-- SCREEN 3: The Surprise -->
    <div class="sc-screen" id="screen-surprise">
      <div class="pzr-reveal-card">
        <div class="pzr-polaroid">
          <img src="<%= photoUrl %>" alt="" />
        </div>
        <p class="pzr-reveal-message" id="revealMessage"></p>
        <p class="pzr-reveal-signature" id="revealSignature">- <%= card.senderName %></p>

        <div class="pzr-next-row">
          <% if (card.fields.questions && card.fields.questions.length) { %>
            <button type="button" class="sc-btn" id="questionsNextBtn" style="display: none;">Next →</button>
          <% } else { %>
            <div class="pzr-final-buttons" id="finalButtons" style="display: none;">
              <button type="button" class="sc-btn" id="playAgainBtn1">Play again 🔁</button>
              <a href="/cards/puzzle/create" class="sc-btn sc-btn-outline">Make your own puzzle ✨</a>
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- SCREEN 4: Questions (only rendered when the sender added at least one) -->
    <% if (card.fields.questions && card.fields.questions.length) { %>
      <div class="sc-screen" id="screen-questions">
        <div id="questionArea" style="display: flex; flex-direction: column; align-items: center; width: 100%;">
          <p class="pzr-q-progress" id="qProgress"></p>
          <p class="pzr-q-text" id="qText"></p>
          <div id="qAnswerArea" style="width: 100%; display: flex; justify-content: center;"></div>
        </div>

        <div id="qSentArea" class="pzr-q-sent" style="display: none;">
          <div class="pzr-hearts-layer" id="qHeartsLayer" style="position: relative; width: 200px; height: 80px; margin: 0 auto;"></div>
          <h2>Your answers have been sent 💌</h2>
          <div class="pzr-final-buttons">
            <button type="button" class="sc-btn" id="playAgainBtn2">Play again 🔁</button>
            <a href="/cards/puzzle/create" class="sc-btn sc-btn-outline">Make your own puzzle ✨</a>
          </div>
        </div>
      </div>
    <% } %>

  </div>

  <div class="pzr-peek-overlay" id="peekOverlay">
    <span class="pzr-peek-label">👀 Peek</span>
    <img src="<%= photoUrl %>" alt="" />
  </div>

  <script src="/js/cardComponents.js"></script>
  <script>
    const S = window.SurpriseCard;
    const SLUG = <%- JSON.stringify(card.slug) %>;
    const CSRF_TOKEN = <%- JSON.stringify(csrfToken) %>;
    const PHOTO_URL = <%- JSON.stringify(photoUrl) %>;
    const N = <%- JSON.stringify(gridSize) %>;
    const prefersReducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const screens = S.createScreenContainer(document.querySelector('.sc-screen-container'));

    document.getElementById('playBtn').addEventListener('click', () => {
      screens.next();
      startPuzzle();
    });

    // --- Board state ---
    const board = document.getElementById('board');
    const statsLine = document.getElementById('statsLine');
    const gameActions = document.getElementById('gameActions');
    const solvedText = document.getElementById('solvedText');
    const peekBtn = document.getElementById('peekBtn');
    const shuffleBtn = document.getElementById('shuffleBtn');
    const peekOverlay = document.getElementById('peekOverlay');

    let piecesAtSlot = []; // piecesAtSlot[slot] = which image region (0..N*N-1) is shown at that slot
    let tileEls = [];
    let selectedSlot = null;
    let moves = 0;
    let peeks = 0;
    let solved = false;
    let timerHandle = null;
    let elapsedSeconds = 0;
    let dragSourceSlot = null;

    function formatTime(total) {
      const m = Math.floor(total / 60);
      const s = total % 60;
      return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
    }

    function updateStatsLine() {
      statsLine.textContent = `Moves: ${moves} · ${formatTime(elapsedSeconds)}`;
    }

    // Pauses while the tab is hidden instead of ticking (and drifting the
    // final recorded time) in the background — same pattern used for the
    // Anniversary countdown.
    function startPausableInterval(fn, ms) {
      let timer = null;
      function start() { if (!timer) { timer = setInterval(fn, ms); } }
      function stop() { clearInterval(timer); timer = null; }
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'hidden') stop(); else if (!solved) start();
      });
      start();
      return { stop };
    }

    function shuffledPermutation(size) {
      let arr = Array.from({ length: size * size }, (_, i) => i);
      const isIdentity = (a) => a.every((v, i) => v === i);
      do {
        for (let i = arr.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [arr[i], arr[j]] = [arr[j], arr[i]];
        }
      } while (isIdentity(arr) && arr.length > 1);
      return arr;
    }

    function paintTile(el, slot) {
      const piece = piecesAtSlot[slot];
      const row = Math.floor(piece / N);
      const col = piece % N;
      el.style.backgroundImage = `url(${PHOTO_URL})`;
      el.style.backgroundSize = `${N * 100}% ${N * 100}%`;
      el.style.backgroundPosition = N > 1
        ? `${(col / (N - 1)) * 100}% ${(row / (N - 1)) * 100}%`
        : '0% 0%';
      el.classList.toggle('pzr-correct-glow', false);
      // Re-trigger the glow animation on a fresh paint if this slot is correct.
      if (piece === slot) {
        requestAnimationFrame(() => el.classList.add('pzr-correct-glow'));
        setTimeout(() => el.classList.remove('pzr-correct-glow'), 950);
      }
    }

    function buildBoard() {
      board.style.gridTemplateColumns = `repeat(${N}, 1fr)`;
      board.style.gridTemplateRows = `repeat(${N}, 1fr)`;
      board.innerHTML = '';
      board.classList.remove('pzr-solved-board');
      tileEls = [];
      for (let slot = 0; slot < N * N; slot++) {
        const tile = document.createElement('div');
        tile.className = 'pzr-tile';
        tile.setAttribute('draggable', 'true');
        tile.dataset.slot = String(slot);
        board.appendChild(tile);
        tileEls.push(tile);
        wireTile(tile, slot);
        paintTile(tile, slot);
      }
    }

    function resetSelection() {
      if (selectedSlot !== null && tileEls[selectedSlot]) tileEls[selectedSlot].classList.remove('pzr-selected');
      selectedSlot = null;
    }

    function swapTiles(slotA, slotB) {
      if (solved || slotA === slotB) return;
      const elA = tileEls[slotA];
      const elB = tileEls[slotB];
      moves += 1;
      updateStatsLine();

      if (prefersReducedMotion) {
        [piecesAtSlot[slotA], piecesAtSlot[slotB]] = [piecesAtSlot[slotB], piecesAtSlot[slotA]];
        paintTile(elA, slotA);
        paintTile(elB, slotB);
        afterSwap();
        return;
      }

      const rectA = elA.getBoundingClientRect();
      const rectB = elB.getBoundingClientRect();
      const dx = rectB.left - rectA.left;
      const dy = rectB.top - rectA.top;

      [elA, elB].forEach((el) => { el.style.zIndex = '4'; el.style.transition = 'transform 280ms ease'; });
      elA.style.transform = `translate(${dx}px, ${dy}px) scale(1.05)`;
      elB.style.transform = `translate(${-dx}px, ${-dy}px) scale(1.05)`;

      setTimeout(() => {
        [piecesAtSlot[slotA], piecesAtSlot[slotB]] = [piecesAtSlot[slotB], piecesAtSlot[slotA]];
        paintTile(elA, slotA);
        paintTile(elB, slotB);
        [elA, elB].forEach((el) => {
          el.style.transition = 'none';
          el.style.transform = '';
          el.style.zIndex = '';
        });
        requestAnimationFrame(() => {
          [elA, elB].forEach((el) => { el.style.transition = ''; });
        });
        afterSwap();
      }, 280);
    }

    function afterSwap() {
      if (piecesAtSlot.every((piece, slot) => piece === slot)) handleSolved();
    }

    function wireTile(tile, slot) {
      tile.addEventListener('click', () => {
        if (solved) return;
        if (selectedSlot === null) {
          selectedSlot = slot;
          tile.classList.add('pzr-selected');
          return;
        }
        if (selectedSlot === slot) {
          resetSelection();
          return;
        }
        const prev = selectedSlot;
        resetSelection();
        swapTiles(prev, slot);
      });

      tile.addEventListener('dragstart', () => { dragSourceSlot = slot; });
      tile.addEventListener('dragover', (e) => e.preventDefault());
      tile.addEventListener('drop', (e) => {
        e.preventDefault();
        if (dragSourceSlot !== null) {
          resetSelection();
          swapTiles(dragSourceSlot, slot);
          dragSourceSlot = null;
        }
      });
    }

    function shuffleBoard() {
      piecesAtSlot = shuffledPermutation(N);
      tileEls.forEach((el, slot) => paintTile(el, slot));
      resetSelection();
    }

    function resetGame() {
      moves = 0;
      elapsedSeconds = 0;
      peeks = 0;
      solved = false;
      updateStatsLine();
      shuffleBoard();
      board.classList.remove('pzr-solved-board');
      gameActions.style.display = '';
      solvedText.style.display = 'none';
      document.getElementById('lockIcon2').textContent = '🔒';
    }

    shuffleBtn.addEventListener('click', resetGame);

    peekBtn.addEventListener('click', () => {
      peeks += 1;
      peekOverlay.classList.add('pzr-peek-visible');
      peekBtn.disabled = true;
      setTimeout(() => {
        peekOverlay.classList.remove('pzr-peek-visible');
        peekBtn.disabled = false;
      }, 2000);
    });

    function handleSolved() {
      solved = true;
      if (pausableTimer) pausableTimer.stop();

      board.classList.add('pzr-solved-board');

      // Shine sweep across the now-complete photo, then confetti.
      setTimeout(() => {
        const shine = document.createElement('div');
        shine.className = 'pzr-shine pzr-shine-run';
        board.appendChild(shine);
        setTimeout(() => shine.remove(), 1200);
        S.burstConfetti({ colors: ['#F28C7A', '#FFE5A0', '#BFD7EA'] });
      }, 520);

      document.getElementById('lockIcon2').textContent = '🔓';
      document.getElementById('lockIcon2').classList.add('pzr-unlock-anim');

      document.getElementById('solvedHeadline').textContent = `You did it! 🎉 Solved in ${moves} moves and ${formatTime(elapsedSeconds)}`;
      gameActions.style.display = 'none';
      setTimeout(() => { solvedText.style.display = 'block'; }, 900);

      // Save stats immediately, independent of whether they ever tap
      // "Unlock my surprise" — an abandoned card should still count as solved.
      fetch(`/c/${SLUG}/solve`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
        body: JSON.stringify({ moves, timeSeconds: elapsedSeconds, peeks, _csrf: CSRF_TOKEN }),
        keepalive: true,
      }).catch(() => {});
    }

    document.getElementById('unlockBtn').addEventListener('click', () => {
      screens.next();
      startSurpriseScreen();
    });

    let pausableTimer = null;

    function startPuzzle() {
      buildBoard();
      resetGame();
      pausableTimer = startPausableInterval(() => {
        elapsedSeconds += 1;
        updateStatsLine();
      }, 1000);
    }

    // --- SCREEN 3: The Surprise ---
    const QUESTIONS = <%- JSON.stringify(card.fields.questions || []) %>;
    const HIDDEN_MESSAGE = <%- JSON.stringify(card.fields.hiddenMessage) %>;
    const revealMessageEl = document.getElementById('revealMessage');
    const revealSignatureEl = document.getElementById('revealSignature');
    let surpriseStarted = false;

    function typeMessage(text, el, onDone) {
      el.textContent = '';
      const caret = document.createElement('span');
      caret.className = 'pzr-letter-caret';
      el.after(caret);

      if (prefersReducedMotion) {
        el.textContent = text;
        caret.remove();
        if (onDone) onDone();
        return;
      }

      let i = 0;
      const timer = setInterval(() => {
        i += 1;
        el.textContent = text.slice(0, i);
        if (i >= text.length) {
          clearInterval(timer);
          caret.remove();
          if (onDone) onDone();
        }
      }, 32);
    }

    function startSurpriseScreen() {
      if (surpriseStarted) return;
      surpriseStarted = true;
      typeMessage(HIDDEN_MESSAGE, revealMessageEl, () => {
        revealSignatureEl.classList.add('pzr-visible');
        setTimeout(() => {
          if (QUESTIONS.length) {
            document.getElementById('questionsNextBtn').style.display = '';
          } else {
            document.getElementById('finalButtons').style.display = '';
          }
        }, 500);
      });
    }

    // --- SCREEN 4: Questions (one at a time, skipped entirely if none) ---
    let resetQuestionsFlow = () => {};
    if (QUESTIONS.length) {
      const questionsNextBtn = document.getElementById('questionsNextBtn');
      const questionArea = document.getElementById('questionArea');
      const qSentArea = document.getElementById('qSentArea');
      const qProgress = document.getElementById('qProgress');
      const qText = document.getElementById('qText');
      const qAnswerArea = document.getElementById('qAnswerArea');
      let qIndex = 0;

      function saveAnswer(index, answer) {
        fetch(`/c/${SLUG}/answer-question`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
          body: JSON.stringify({ questionIndex: index, answer, _csrf: CSRF_TOKEN }),
          keepalive: true,
        }).catch(() => {});
      }

      function renderQuestion() {
        const q = QUESTIONS[qIndex];
        qProgress.textContent = `${qIndex + 1} of ${QUESTIONS.length}`;
        qText.textContent = q.text;
        qAnswerArea.innerHTML = '';

        if (q.type === 'yesno') {
          const wrap = document.createElement('div');
          wrap.className = 'pzr-q-yesno';
          ['Yes', 'No'].forEach((label) => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'sc-btn';
            btn.textContent = label;
            btn.addEventListener('click', () => submitAnswer(label.toLowerCase()));
            wrap.appendChild(btn);
          });
          qAnswerArea.appendChild(wrap);
        } else if (q.type === 'multiple') {
          const wrap = document.createElement('div');
          wrap.className = 'pzr-q-options';
          (q.options || []).forEach((option) => {
            const card = document.createElement('div');
            card.className = 'pzr-q-option-card';
            card.textContent = option;
            card.addEventListener('click', () => submitAnswer(option));
            wrap.appendChild(card);
          });
          qAnswerArea.appendChild(wrap);
        } else {
          const wrap = document.createElement('div');
          wrap.className = 'pzr-q-short';
          const textarea = document.createElement('textarea');
          textarea.maxLength = 200;
          textarea.placeholder = 'Type your answer...';
          const count = document.createElement('p');
          count.className = 'pzr-q-short-count';
          count.textContent = '0 / 200';
          textarea.addEventListener('input', () => { count.textContent = `${textarea.value.length} / 200`; });
          const sendBtn = document.createElement('button');
          sendBtn.type = 'button';
          sendBtn.className = 'sc-btn';
          sendBtn.textContent = 'Send';
          sendBtn.addEventListener('click', () => {
            const value = textarea.value.trim();
            if (!value) return;
            submitAnswer(value);
          });
          wrap.appendChild(textarea);
          wrap.appendChild(count);
          wrap.appendChild(sendBtn);
          qAnswerArea.appendChild(wrap);
        }
      }

      function submitAnswer(answer) {
        saveAnswer(qIndex, answer);
        qIndex += 1;
        if (qIndex >= QUESTIONS.length) {
          questionArea.style.display = 'none';
          qSentArea.style.display = 'block';
          S.startFloatingHearts(document.getElementById('qHeartsLayer'), { color: '#F28C7A', count: 8 });
        } else {
          renderQuestion();
        }
      }

      questionsNextBtn.addEventListener('click', () => {
        screens.next();
        renderQuestion();
      });

      resetQuestionsFlow = () => {
        qIndex = 0;
        questionArea.style.display = '';
        qSentArea.style.display = 'none';
        questionsNextBtn.style.display = 'none';
      };
    }

    // --- Final buttons: replay the puzzle from scratch ---
    const puzzleScreenIndex = screens.screens.indexOf(document.getElementById('screen-puzzle'));
    const finalButtonsEl = document.getElementById('finalButtons');
    function playAgain() {
      surpriseStarted = false;
      revealMessageEl.textContent = '';
      revealSignatureEl.classList.remove('pzr-visible');
      if (finalButtonsEl) finalButtonsEl.style.display = 'none';
      resetQuestionsFlow();
      screens.goTo(puzzleScreenIndex);
      startPuzzle();
    }
    const playAgainBtn1 = document.getElementById('playAgainBtn1');
    if (playAgainBtn1) playAgainBtn1.addEventListener('click', playAgain);
    const playAgainBtn2 = document.getElementById('playAgainBtn2');
    if (playAgainBtn2) playAgainBtn2.addEventListener('click', playAgain);
  </script>
</body>
</html>
