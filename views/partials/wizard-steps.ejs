<%
  const stepLabels = ['Template', 'Details', 'Photos', 'Message', 'Music', 'Preview'];
%>
<div class="flex items-center gap-2 mb-6 overflow-x-auto pb-2">
  <% stepLabels.forEach((label, i) => { %>
    <div class="flex items-center gap-2 shrink-0">
      <span class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold
        <%= i + 1 === step ? 'bg-amber-600 text-white' : i + 1 < step ? 'bg-amber-100 text-amber-700' : 'bg-stone-100 text-stone-400' %>">
        <%= i + 1 %>
      </span>
      <span class="text-sm font-semibold <%= i + 1 === step ? 'text-stone-800' : 'text-stone-400' %>"><%= label %></span>
      <% if (i < stepLabels.length - 1) { %><span class="text-stone-300">&rarr;</span><% } %>
    </div>
  <% }) %>
</div>
