<%
// Three small, original, hand-drawn mood-character icons for the Apology
// card (shy bunny / sad teddy / cat with flowers) — shared between the
// mood picker, the live preview, and the loading-screen wave animation.
// `mood` is one of 'bunny' | 'teddy' | 'cat'.
%>
<% if (mood === 'bunny') { %>
<svg viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
  <ellipse cx="46" cy="24" rx="9" ry="22" fill="var(--white-soft)" stroke="var(--gold)" stroke-width="2"/>
  <ellipse cx="74" cy="24" rx="9" ry="22" fill="var(--white-soft)" stroke="var(--gold)" stroke-width="2"/>
  <ellipse cx="46" cy="26" rx="4" ry="13" fill="var(--blush)"/>
  <ellipse cx="74" cy="26" rx="4" ry="13" fill="var(--blush)"/>
  <circle cx="60" cy="66" r="38" fill="var(--white-soft)" stroke="var(--gold)" stroke-width="2"/>
  <circle cx="44" cy="80" r="7" fill="var(--blush)"/>
  <circle cx="76" cy="80" r="7" fill="var(--blush)"/>
  <path class="mc-eye" d="M46 62 q4 5 8 0" stroke="var(--cocoa)" stroke-width="2.5" stroke-linecap="round"/>
  <path class="mc-eye" d="M66 62 q4 5 8 0" stroke="var(--cocoa)" stroke-width="2.5" stroke-linecap="round"/>
  <circle cx="60" cy="72" r="3" fill="var(--rose)"/>
  <path d="M52 80 q8 6 16 0" stroke="var(--cocoa)" stroke-width="2" stroke-linecap="round"/>
</svg>
<% } else if (mood === 'teddy') { %>
<svg viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
  <circle cx="30" cy="30" r="14" fill="var(--gold)"/>
  <circle cx="90" cy="30" r="14" fill="var(--gold)"/>
  <circle cx="30" cy="30" r="6" fill="var(--blush)"/>
  <circle cx="90" cy="30" r="6" fill="var(--blush)"/>
  <circle cx="60" cy="64" r="40" fill="var(--gold)"/>
  <ellipse cx="60" cy="74" rx="20" ry="16" fill="var(--white-soft)"/>
  <circle class="mc-eye" cx="47" cy="58" r="4.5" fill="var(--cocoa)"/>
  <circle class="mc-eye" cx="73" cy="58" r="4.5" fill="var(--cocoa)"/>
  <ellipse cx="60" cy="70" rx="6" ry="4.5" fill="var(--cocoa)"/>
  <path d="M50 82 q10 -6 20 0" stroke="var(--cocoa)" stroke-width="2" stroke-linecap="round" fill="none"/>
  <path d="M78 64 q4 6 2 11" stroke="#8FBFE0" stroke-width="2.5" stroke-linecap="round" fill="none"/>
</svg>
<% } else { %>
<svg viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
  <path d="M34 22 L46 44 L26 44 Z" fill="var(--white-soft)" stroke="var(--gold)" stroke-width="2"/>
  <path d="M86 22 L94 44 L74 44 Z" fill="var(--white-soft)" stroke="var(--gold)" stroke-width="2"/>
  <circle cx="60" cy="64" r="38" fill="var(--white-soft)" stroke="var(--gold)" stroke-width="2"/>
  <path class="mc-eye" d="M44 60 q4 -6 8 0" stroke="var(--cocoa)" stroke-width="2.5" stroke-linecap="round" fill="none"/>
  <path class="mc-eye" d="M68 60 q4 -6 8 0" stroke="var(--cocoa)" stroke-width="2.5" stroke-linecap="round" fill="none"/>
  <path d="M58 72 l4 4 l4 -4" stroke="var(--cocoa)" stroke-width="2" stroke-linecap="round" fill="none"/>
  <path d="M30 70 h-14 M30 74 h-15 M90 70 h14 M90 74 h15" stroke="var(--cocoa)" stroke-width="1.5" stroke-linecap="round"/>
  <g transform="translate(90,86)">
    <circle r="5" fill="var(--rose)"/>
    <circle cx="8" r="5" fill="var(--rose)"/>
    <circle cx="-8" r="5" fill="var(--rose)"/>
    <circle cy="8" r="5" fill="var(--rose)"/>
    <circle cy="-8" r="5" fill="var(--rose)"/>
    <circle r="3.5" fill="var(--gold)"/>
  </g>
</svg>
<% } %>
