<footer class="border-t border-amber-100 bg-white mt-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 grid sm:grid-cols-3 gap-8">
    <div>
      <a href="/" class="font-display text-xl font-semibold text-amber-700 flex items-center gap-2">
        🎈 <%= settings.siteName %>
      </a>
      <p class="text-sm text-stone-500 mt-2">Animated birthday wishes and love proposals, shared with one link.</p>
      <% if (settings.social && (settings.social.instagramUrl || settings.social.facebookUrl || settings.social.twitterUrl || settings.social.youtubeUrl)) { %>
        <div class="flex gap-3 mt-4">
          <% if (settings.social.instagramUrl) { %><a href="<%= settings.social.instagramUrl %>" target="_blank" rel="noopener" class="text-stone-400 hover:text-rose-600 text-sm font-semibold">Instagram</a><% } %>
          <% if (settings.social.facebookUrl) { %><a href="<%= settings.social.facebookUrl %>" target="_blank" rel="noopener" class="text-stone-400 hover:text-amber-700 text-sm font-semibold">Facebook</a><% } %>
          <% if (settings.social.twitterUrl) { %><a href="<%= settings.social.twitterUrl %>" target="_blank" rel="noopener" class="text-stone-400 hover:text-amber-700 text-sm font-semibold">Twitter</a><% } %>
          <% if (settings.social.youtubeUrl) { %><a href="<%= settings.social.youtubeUrl %>" target="_blank" rel="noopener" class="text-stone-400 hover:text-rose-600 text-sm font-semibold">YouTube</a><% } %>
        </div>
      <% } %>
    </div>

    <div class="text-sm">
      <p class="font-semibold text-stone-700 mb-2">Company</p>
      <ul class="space-y-2 text-stone-500">
        <li><a href="/terms" class="hover:text-amber-700">Terms of Service</a></li>
        <li><a href="/privacy" class="hover:text-amber-700">Privacy Policy</a></li>
        <li><a href="/refund-policy" class="hover:text-amber-700">Refund Policy</a></li>
        <li><a href="/contact" class="hover:text-amber-700">Contact</a></li>
      </ul>
    </div>

    <div class="text-sm">
      <p class="font-semibold text-stone-700 mb-2">Support</p>
      <p class="text-stone-500">Need help? <a href="mailto:<%= settings.supportEmail %>" class="text-amber-700 font-semibold"><%= settings.supportEmail %></a></p>
    </div>
  </div>
  <div class="border-t border-amber-50">
    <p class="max-w-6xl mx-auto px-4 sm:px-6 py-4 text-xs text-stone-400">&copy; <%= new Date().getFullYear() %> <%= settings.siteName %>. All rights reserved.</p>
  </div>
</footer>
