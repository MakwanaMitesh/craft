<%- include('../layouts/dashboard-head', { title }) %>

<%- include('../partials/wizard-steps', { step }) %>

<div class="max-w-xl card-panel">
  <form action="/dashboard/cards/<%= card._id %>/build/message" method="POST" id="messageForm" class="space-y-4"><input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div>
      <label class="label">Your message</label>
      <div class="flex gap-1 mb-2">
        <button type="button" data-cmd="bold" class="btn-secondary px-3 py-1 text-sm font-bold">B</button>
        <button type="button" data-cmd="italic" class="btn-secondary px-3 py-1 text-sm italic">I</button>
        <button type="button" data-cmd="underline" class="btn-secondary px-3 py-1 text-sm underline">U</button>
      </div>
      <div
        id="editor"
        class="input-field min-h-[160px]"
        contenteditable="true"
        style="white-space: pre-wrap;"
      ><%- card.message || '' %></div>
      <input type="hidden" name="message" id="messageInput" />
      <p class="text-xs mt-1" id="charCount">0 / <%= charLimit %> characters</p>
    </div>

    <div class="flex items-center justify-between pt-2">
      <a href="/dashboard/cards/<%= card._id %>/build/photos" class="btn-secondary">&larr; Back</a>
      <button type="submit" class="btn-primary">Continue</button>
    </div>
  </form>
</div>

<script>
  const editor = document.getElementById('editor');
  const charCount = document.getElementById('charCount');
  const charLimit = <%= charLimit %>;

  function updateCount() {
    const length = editor.innerText.replace(/\n/g, '').length;
    charCount.textContent = `${length} / ${charLimit} characters`;
    charCount.classList.toggle('text-rose-600', length > charLimit);
    charCount.classList.toggle('text-stone-400', length <= charLimit);
  }

  editor.addEventListener('input', updateCount);
  updateCount();

  document.querySelectorAll('[data-cmd]').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.execCommand(btn.dataset.cmd);
      editor.focus();
    });
  });

  document.getElementById('messageForm').addEventListener('submit', () => {
    document.getElementById('messageInput').value = editor.innerHTML;
  });
</script>

<%- include('../layouts/dashboard-foot') %>
