<%- include('../layouts/dashboard-head', { title }) %>

<a href="/dashboard" class="text-sm text-amber-700 font-semibold mb-4 inline-block">&larr; Back to my cards</a>

<div class="flex items-center justify-between flex-wrap gap-3 mb-6">
  <div>
    <h2 class="text-xl font-semibold"><%= card.recipientName || card.partnerName %></h2>
    <p class="text-sm text-stone-400"><%= card.template?.name %> &middot; <%= card.occasion[0].toUpperCase() + card.occasion.slice(1) %></p>
  </div>
  <% if (analyticsLevel === 'basic') { %>
    <span class="text-xs font-semibold px-3 py-1.5 rounded-full bg-stone-100 text-stone-500">
      Basic analytics — upgrade your plan for device, location &amp; activity detail
    </span>
  <% } %>
</div>

<div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-5 mb-6">
  <div class="card-panel">
    <p class="text-sm text-stone-500">Total views</p>
    <p class="text-2xl font-semibold mt-1"><%= stats.totalViews %></p>
  </div>
  <div class="card-panel">
    <p class="text-sm text-stone-500">Unique visitors</p>
    <p class="text-2xl font-semibold mt-1"><%= stats.uniqueVisitors %></p>
  </div>
  <div class="card-panel">
    <p class="text-sm text-stone-500">First opened</p>
    <p class="text-sm font-semibold mt-1"><%= stats.firstOpenedAt ? stats.firstOpenedAt.toLocaleString() : 'Not yet' %></p>
  </div>
  <div class="card-panel">
    <p class="text-sm text-stone-500">Last opened</p>
    <p class="text-sm font-semibold mt-1"><%= stats.lastOpenedAt ? stats.lastOpenedAt.toLocaleString() : 'Not yet' %></p>
  </div>
  <div class="card-panel">
    <p class="text-sm text-stone-500">Avg. time spent</p>
    <p class="text-2xl font-semibold mt-1"><%= stats.avgTimeSpent %>s</p>
  </div>
</div>

<div class="card-panel mb-6">
  <h3 class="font-semibold mb-4">Views over time</h3>
  <canvas id="viewsChart" height="80"></canvas>
</div>

<% if (card.occasion === 'birthday') { %>
  <div class="card-panel mb-6">
    <h3 class="font-semibold mb-4">Engagement</h3>
    <div class="grid sm:grid-cols-3 gap-4 text-sm">
      <div class="flex items-center gap-2"><span class="text-xl"><%= birthday.candlesBlown ? '✅' : '➖' %></span> Blew out the candles</div>
      <div class="flex items-center gap-2"><span class="text-xl"><%= birthday.letterOpened ? '✅' : '➖' %></span> Read the letter</div>
      <div class="flex items-center gap-2"><span class="text-xl">↺</span> Replayed <%= birthday.replays %> time<%= birthday.replays === 1 ? '' : 's' %></div>
    </div>
  </div>
<% } else { %>
  <div class="card-panel mb-6">
    <h3 class="font-semibold mb-4">Response</h3>
    <% if (proposal.respondedYes) { %>
      <p class="text-sm text-stone-600">💖 Said YES on <strong><%= proposal.respondedAt.toLocaleString() %></strong>, after <strong><%= proposal.noAttempts %></strong> NO attempt<%= proposal.noAttempts === 1 ? '' : 's' %>.</p>
    <% } else { %>
      <p class="text-sm text-stone-500">Still waiting for an answer.</p>
    <% } %>
  </div>
<% } %>

<% if (analyticsLevel === 'full') { %>
  <div class="grid lg:grid-cols-2 gap-6 mb-6">
    <div class="card-panel">
      <h3 class="font-semibold mb-4">Device breakdown</h3>
      <canvas id="deviceChart" height="160"></canvas>
    </div>
    <div class="card-panel">
      <h3 class="font-semibold mb-3">Top cities</h3>
      <div class="space-y-2 text-sm">
        <% byCity.forEach(c => { %>
          <div class="flex items-center justify-between"><span class="text-stone-600"><%= c._id %></span><span class="font-semibold"><%= c.count %></span></div>
        <% }) %>
        <% if (!byCity.length) { %><p class="text-stone-400">No location data yet.</p><% } %>
      </div>
    </div>
  </div>

  <div class="card-panel">
    <h3 class="font-semibold mb-4">Recent activity</h3>
    <ul class="space-y-2 text-sm text-stone-600">
      <% recentActivity.forEach(line => { %>
        <li>&bull; <%= line %></li>
      <% }) %>
      <% if (!recentActivity.length) { %>
        <li class="text-stone-400">No activity yet.</li>
      <% } %>
    </ul>
  </div>
<% } %>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script>
  new Chart(document.getElementById('viewsChart'), {
    type: 'line',
    data: {
      labels: <%- JSON.stringify(viewsLabels) %>,
      datasets: [{ data: <%- JSON.stringify(viewsValues) %>, borderColor: '#B45309', backgroundColor: 'rgba(180, 83, 9, 0.12)', fill: true, tension: 0.3, pointRadius: 0 }],
    },
    options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } },
  });

  <% if (analyticsLevel === 'full') { %>
  new Chart(document.getElementById('deviceChart'), {
    type: 'doughnut',
    data: {
      labels: <%- JSON.stringify(byDevice.map(d => d._id || 'unknown')) %>,
      datasets: [{ data: <%- JSON.stringify(byDevice.map(d => d.count)) %>, backgroundColor: ['#B45309', '#E11D48', '#0EA5E9'] }],
    },
    options: { plugins: { legend: { position: 'bottom' } } },
  });
  <% } %>
</script>

<%- include('../layouts/dashboard-foot') %>
