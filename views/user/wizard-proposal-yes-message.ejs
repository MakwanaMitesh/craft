<%- include('../layouts/dashboard-head', { title }) %>

<%- include('../partials/wizard-steps-proposal', { step }) %>

<div class="max-w-xl card-panel">
  <form
    action="/dashboard/cards/<%= card._id %>/build/proposal/yes-message" method="POST" enctype="multipart/form-data"
    id="yesMessageForm" class="space-y-5"
  ><input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div>
      <label class="label">Message shown after they say YES</label>
      <div class="flex gap-1 mb-2">
        <button type="button" data-cmd="bold" class="btn-secondary px-3 py-1 text-sm font-bold">B</button>
        <button type="button" data-cmd="italic" class="btn-secondary px-3 py-1 text-sm italic">I</button>
        <button type="button" data-cmd="underline" class="btn-secondary px-3 py-1 text-sm underline">U</button>
      </div>
      <div
        id="editor"
        class="input-field min-h-[140px]"
        contenteditable="true"
        style="white-space: pre-wrap;"
      ><%- card.yesMessage || '' %></div>
      <input type="hidden" name="yesMessage" id="yesMessageInput" />
      <p class="text-xs mt-1" id="charCount">0 / <%= charLimit %> characters</p>
    </div>

    <div>
      <label class="label" for="photos">Photos (optional, up to <%= maxPhotos %>)</label>
      <% if (card.photos && card.photos.length) { %>
        <div class="flex gap-2 mb-2 flex-wrap">
          <% card.photos.forEach(p => { %>
            <img src="<%= p %>" alt="Uploaded photo" class="w-16 h-16 object-cover rounded-lg" />
          <% }) %>
        </div>
      <% } %>
      <input class="input-field" type="file" id="photos" name="photos" accept="image/jpeg,image/png,image/webp" multiple />
      <p class="text-xs text-stone-400 mt-1">Uploading new photos replaces the current set.</p>
    </div>

    <div class="flex items-center justify-between pt-2">
      <a href="/dashboard/cards/<%= card._id %>/build/proposal/sticker" class="btn-secondary">&larr; Back</a>
      <button type="submit" class="btn-primary">Continue</button>
    </div>
  </form>
</div>

<script>
  const editor = document.getElementById('editor');
  const charCount = document.getElementById('charCount');
  const charLimit = <%= charLimit %>;

  function updateCount() {
    const length = editor.innerText.replace(/\n/g, '').length;
    charCount.textContent = `${length} / ${charLimit} characters`;
    charCount.classList.toggle('text-rose-600', length > charLimit);
    charCount.classList.toggle('text-stone-400', length <= charLimit);
  }

  editor.addEventListener('input', updateCount);
  updateCount();

  document.querySelectorAll('[data-cmd]').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.execCommand(btn.dataset.cmd);
      editor.focus();
    });
  });

  document.getElementById('yesMessageForm').addEventListener('submit', () => {
    document.getElementById('yesMessageInput').value = editor.innerHTML;
  });
</script>

<%- include('../layouts/dashboard-foot') %>
